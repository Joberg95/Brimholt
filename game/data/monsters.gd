## Monsters notice players within AGGRO_RANGE tiles (so you can pull one at a camp's edge),
## give up beyond CHASE_RANGE from themselves, and never chase beyond LEASH from home.
const AGGRO_RANGE: int = 3
const CHASE_RANGE: int = 12
const LEASH: int = 12
## A killed monster comes back this long after (champions and bosses set their own "respawn"):
## slow enough that a camp does not refill under a party's feet, now that the countryside has
## more camps (tools/generators/fill_gaps.gd).
const RESPAWN_SECONDS: float = 75.0
## Monsters whose attacks are magic (cut by magic defense, not defense): wraiths, the lich, and
## the Hollow Bloom. Every other monster hits physically (Balance.ARMOR_TYPES).
const MAGIC_ATTACKERS: Array[String] = ["cinder_wraith", "void_wraith", "barrow_lich", "sylvaine", "lizard_shaman",
	"marsh_witch", "ogre_shaman", "drowned_priest", "drowned_abbess", "ember_witch",
	"icetide_shaman"]


## A monster's nameplate and target-frame title: "Elite " before an elite's name, its level, and
## "ENRAGED" while a boss rages.
static func title(kind: String, level: int, enraged: bool = false) -> String:
	var definition: Dictionary = MONSTERS.get(kind, {"name": "?", "rank": "normal"})
	return "%s%s %d%s" % ["Elite " if definition.get("rank", "") == "elite" else "", definition["name"], level,
		"  ENRAGED" if enraged else ""]
