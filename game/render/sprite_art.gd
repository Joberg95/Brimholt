extends RefCounted
## Draws Brimholt from the original sprite sheets in res://assets/sprites (generated by
## tools/generators/make_sprites.py and editable by hand). Character-style sheets use 64x64 frames:
## columns stand/step A/step B, rows down/up/left/right, tile centre at (32, 40), so
## unarmoured characters stand about 36 pixels tall; their feet remain at frame y=53.

const World = preload("res://game/core/world.gd")
const Monsters = preload("res://game/data/monsters.gd")
const FRAME: float = 64.0
const FRAME_ANCHOR: Vector2 = Vector2(32, 40)
const TILE: float = 32.0
const WALL_SIZE: float = 48.0
const WALL_RAISE: float = 16.0
const DIRECTIONS: Array[Vector2i] = [Vector2i.DOWN, Vector2i.UP, Vector2i.LEFT, Vector2i.RIGHT]
const OUTLINE: Color = Color("#1a1612")
## Player hood/tabard tints; the cloth sheet is greyscale. Capes are equipped items only.
const COLORS: Array[Color] = [Color("#97735b"), Color("#71848e"), Color("#827483"), Color("#998b68")]
const BODY: Texture2D = preload("res://assets/sprites/body.png")
const CLOTH: Texture2D = preload("res://assets/sprites/cloth.png")
const MARKER: Texture2D = preload("res://assets/sprites/marker.png")
const ITEM_ICONS: Texture2D = preload("res://assets/sprites/items.png")
const TILES: Texture2D = preload("res://assets/sprites/tiles.png")
const WALLS: Texture2D = preload("res://assets/sprites/walls.png")
const OBJECTS: Texture2D = preload("res://assets/sprites/objects.png")
## Roof material swatches (one row per material), rasterized per building by roof_art.gd.
const ROOFS: Texture2D = preload("res://assets/sprites/roofs.png")
const RoofArt = preload("res://game/render/roof_art.gd")
const Buildings = preload("res://game/data/buildings.gd")
## Shop and bank furniture, 32x48 cells drawn 16 px above their tile (make_sprites.py FURNITURE_KINDS).
const FURNITURE_SHEET: Texture2D = preload("res://assets/sprites/furniture.png")
const FURNITURE: Array[String] = ["counter_shop", "counter_bank", "shelf_potions", "shelf_books", "weapon_rack", "barrel",
	"crate", "strongbox"]
## Row 3 of walls.png: thin walls for "#", indexed by connected sides (1 N, 2 W, 4 S, 8 E).
const THIN_WALL_ROW: int = 3
static var _roofs: Dictionary = {}
## Hanging shop signs, one 32x32 board per keeper role.
const SIGNS: Texture2D = preload("res://assets/sprites/signs.png")
const SIGN_KINDS: Array[String] = ["vendor", "banker"]
## Wall torches (World.TORCHES): 16x24 frames, unlit then three flame frames.
const TORCH: Texture2D = preload("res://assets/sprites/torch.png")
## Where a sign's centre hangs from its wall cell's corner, by the direction the door faces:
## on the visible south or east face, or standing on the roof edge for a north or west door.
const SIGN_OFFSETS: Dictionary = {
	Vector2i.DOWN: Vector2(14, 16), Vector2i.UP: Vector2(0, -24), Vector2i.RIGHT: Vector2(14, 8), Vector2i.LEFT: Vector2(-12, 6),
}
## Trees are 64x96 cells in objects.png with the trunk base on the tile centre at (32, 80).
const TREE_SIZE: Vector2 = Vector2(64, 96)
const TREE_ANCHOR: Vector2 = Vector2(32, 80)
const TREE_VARIANTS: int = 3
const NPC_TINT: Color = Color("#4f7f86")
## Creature sheets are greyscale (tinted per monster) with untinted eye/detail sheets.
const MONSTER_SHEETS: Dictionary = {
	"quadruped": preload("res://assets/sprites/monsters/quadruped.png"),
	"spider": preload("res://assets/sprites/monsters/spider.png"),
	"blob": preload("res://assets/sprites/monsters/blob.png"),
	"golem": preload("res://assets/sprites/monsters/golem.png"),
	"wraith": preload("res://assets/sprites/monsters/wraith.png"),
}
const MONSTER_DETAILS: Dictionary = {
	"quadruped": preload("res://assets/sprites/monsters/quadruped_detail.png"),
	"spider": preload("res://assets/sprites/monsters/spider_detail.png"),
	"blob": preload("res://assets/sprites/monsters/blob_detail.png"),
	"golem": preload("res://assets/sprites/monsters/golem_detail.png"),
	"wraith": preload("res://assets/sprites/monsters/wraith_detail.png"),
}
## Characters' feet sit this far below the tile centre; monsters scale around that point.
const FEET: Vector2 = Vector2(0, 13.5)
## Source rectangles of tiles.png by tile index (4 per row), computed once.
static var TILE_REGIONS: Array[Rect2] = _tile_regions()
## Icon order in items.png: the catalog order of game/data/items.json.
static var ITEM_ORDER: Array[String] = _item_order()
## Slots drawn on the character (no cape is drawn when its slot is empty). Rings, necklaces, and charms
## are too small to show when worn.
const VISIBLE_SLOTS: Array[String] = ["helmet", "cape", "armor", "legs", "boots", "main_hand", "off_hand"]
## One sheet per visible item: assets/sprites/gear/<id>.png.
static var GEAR: Dictionary = _gear_sheets()
## Painted full-figure outfits by armor kind (imported from art/outfits by
## tools/generators/import_outfits.gd): worn armor with an outfit replaces the body, helmet, armor,
## legs, boots, and cape layers; weapons and shields are still drawn. Painted item icons
## (assets/sprites/icons/<id>.png) and icons derived from them (assets/sprites/icons_derived/<id>.png)
## replace generated ones. Painted item icons (assets/sprites/icons/<id>.png) replace generated ones.
static var OUTFITS: Dictionary = _outfit_sheets()
static var ICONS: Dictionary = _icon_overrides()
## Relics glow: white halo sheets (gear/<id>_glow.png, items_glow.png, monsters/<look>_glow.png)
## drawn additively in the item's "glow" colour by game/render/glow_layer.gd.
static var GEAR_GLOW: Dictionary = _gear_sheets("_glow")
const ITEM_GLOW: Texture2D = preload("res://assets/sprites/items_glow.png")
const MONSTER_GLOW: Dictionary = {
	"golem": preload("res://assets/sprites/monsters/golem_glow.png"),
	"wraith": preload("res://assets/sprites/monsters/wraith_glow.png"),
}
const GRASS_TILES: Array[int] = [0, 1, 2, 0, 1, 2, 0, 3]
const DIRT_TILE: int = 4
const WATER_TILE: int = 8
const DIRT_EDGE_TILE: int = 12
const SHORE_TILE: int = 16
const SAND_TILE: int = 20
const COBBLE_TILE: int = 24
const PLANK_TILE: int = 28
const VERTICAL_PLANK_TILE: int = 30
const DUSK_TILE: int = 32
const OBSIDIAN_TILE: int = 36
const CAVE_TILE: int = 40
const STAIRS_DOWN_TILE: int = 44
const STAIRS_UP_TILE: int = 45
## Dry grass fringes on sand next to grass (north, east, south, west).
const SAND_EDGE_TILE: int = 46
## objects.png: three living trees, two dead trees of the Hollow Reach, then three desert
## plants (a columnar cactus, a clump of barrel cacti, and a thorn shrub).
const DEAD_TREE_FIRST: int = 3
const DEAD_TREE_VARIANTS: int = 2
const DESERT_PLANT_FIRST: int = 5
const DESERT_PLANT_VARIANTS: int = 3
## Edge overlay order in the tile sheet: north, east, south, west.
const EDGES: Array[Vector2i] = [Vector2i.UP, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.LEFT]


static func _item_order() -> Array[String]:
	var order: Array[String] = []
	order.assign(World.ITEMS.keys())
	return order


static func _gear_sheets(suffix: String = "") -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in World.ITEMS:
		if VISIBLE_SLOTS.has(World.ITEMS[kind]["slot"]) and (suffix.is_empty() or World.ITEMS[kind].has("glow")):
			sheets[kind] = load("res://assets/sprites/gear/%s%s.png" % [kind, suffix])
	return sheets


static func _outfit_sheets() -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in World.ITEMS:
		var path: String = "res://assets/sprites/outfits/%s.png" % World.ITEMS[kind].get("outfit", "")
		if World.ITEMS[kind].has("outfit") and ResourceLoader.exists(path):
			sheets[kind] = load(path)
	return sheets


static func _icon_overrides() -> Dictionary:
	var icons: Dictionary = {}
	# Painted icons first, then icons derived from them (tools/generators/derive_icons.py).
	for kind: String in World.ITEMS:
		for folder: String in ["icons", "icons_derived"]:
			var path: String = "res://assets/sprites/%s/%s.png" % [folder, kind]
			if ResourceLoader.exists(path):
				icons[kind] = load(path)
				break
	return icons


static func tile_at(cell: Vector2i) -> String:
	return World.terrain(cell)


static func noise(cell: Vector2i, salt: int) -> int:
	return absi((cell.x * 73856093) ^ (cell.y * 19349663) ^ (salt * 83492791)) % 1000003


static func _tile_region(index: int) -> Rect2:
	return TILE_REGIONS[index]


static func _tile_regions() -> Array[Rect2]:
	var regions: Array[Rect2] = []
	for index: int in 64:
		regions.append(Rect2(Vector2(index % 4, index / 4) * TILE, Vector2.ONE * TILE))
	return regions


static func draw_floor(canvas: CanvasItem, cell: Vector2i, time: float) -> void:
	var dest: Rect2 = Rect2(Vector2(cell) * TILE, Vector2.ONE * TILE)
	var tile: String = tile_at(cell)
	if tile == " " or tile.is_empty():
		canvas.draw_rect(dest, Color.BLACK)
		return
	if tile == "#":
		_draw_wall_floor(canvas, cell, dest)
		return
	canvas.draw_texture_rect_region(TILES, dest, _tile_region(_floor_index(tile, cell, time)))
	# Only roads, dusk soil, sand, water, and piers have edge overlays; skip neighbour lookups otherwise.
	if tile != "," and tile != "d" and tile != "~" and tile != "b" and tile != ":" and tile != "K":
		return
	for side: int in EDGES.size():
		var neighbor: String = tile_at(cell + EDGES[side])
		if (tile == ":" or tile == "K") and (neighbor == "." or neighbor == "T"):
			canvas.draw_texture_rect_region(TILES, dest, _tile_region(SAND_EDGE_TILE + side))
		elif (tile == "," and neighbor == ".") or (tile == "d" and neighbor in [".", ","]):
			canvas.draw_texture_rect_region(TILES, dest, _tile_region(DIRT_EDGE_TILE + side))
		elif (tile == "~" or tile == "b") and not neighbor.is_empty() and neighbor in World.LAND:
			canvas.draw_texture_rect_region(TILES, dest, _tile_region(SHORE_TILE + side))
	if tile == "b":
		var plank: int = PLANK_TILE if _run(cell, Vector2i.DOWN) > _run(cell, Vector2i.RIGHT) else VERTICAL_PLANK_TILE
		canvas.draw_texture_rect_region(TILES, dest, _tile_region(plank + noise(cell, 6) % 2))


## A thin wall stands in the middle of its tile: the ground outside shows on one side and a
## building's floor on the inside (each quarter toward a room cell).
static func _draw_wall_floor(canvas: CanvasItem, cell: Vector2i, dest: Rect2) -> void:
	var outside: String = "."
	var inside: String = ""
	for side: Vector2i in EDGES:
		var tile: String = tile_at(cell + side)
		if tile.is_empty() or tile in World.WALLS or tile in World.TREES or tile == "~" or tile == "b":
			continue
		if World.ROOM_AT.has(cell + side):
			inside = tile if inside.is_empty() and tile in World.LAND and tile != "v" else inside
		elif outside == ".":
			outside = tile
	canvas.draw_texture_rect_region(TILES, dest, _tile_region(_floor_index(outside, cell, 0.0)))
	if inside.is_empty():
		inside = "="
	var region: Rect2 = _tile_region(_floor_index(inside, cell, 0.0))
	for quarter: Vector2i in [Vector2i(-1, -1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(1, 1)]:
		if World.ROOM_AT.has(cell + Vector2i(quarter.x, 0)) or World.ROOM_AT.has(cell + Vector2i(0, quarter.y)) \
				or World.ROOM_AT.has(cell + quarter):
			var offset := Vector2(16 if quarter.x > 0 else 0, 16 if quarter.y > 0 else 0)
			canvas.draw_texture_rect_region(TILES, Rect2(dest.position + offset, Vector2(16, 16)),
				Rect2(region.position + offset, Vector2(16, 16)))


static func _floor_index(tile: String, cell: Vector2i, time: float) -> int:
	var index: int = GRASS_TILES[noise(cell, 1) % GRASS_TILES.size()]
	if tile == ",":
		index = DIRT_TILE + noise(cell, 2) % 4
	elif tile == "~" or tile == "b":
		index = WATER_TILE + (int(time * 3.0) + noise(cell, 3)) % 4
	elif tile == ":" or tile == "K":
		index = SAND_TILE + noise(cell, 4) % 4
	elif tile == "=":
		index = COBBLE_TILE + noise(cell, 5) % 4
	elif tile == "d" or tile == "D" or tile == "O":
		index = DUSK_TILE + noise(cell, 8) % 4
	elif tile == "o":
		index = obsidian_variant(cell)
	elif tile == "c" or tile == "C" and not World.OVERWORLD.has_point(cell):
		# Rock outcrops on the overworld stand on grass; cave rock in dungeons on cave floor.
		index = CAVE_TILE + noise(cell, 11) % 4
	elif tile == "v":
		index = STAIRS_DOWN_TILE
	elif tile == "^":
		index = STAIRS_UP_TILE
	return index


## Obsidian flagstones; the rune-carved stone (variant 0) appears on about one tile in twelve.
static func obsidian_variant(cell: Vector2i) -> int:
	return OBSIDIAN_TILE + (0 if noise(cell, 9) % 12 == 0 else 1 + noise(cell, 10) % 3)


## Length of the pier or bridge through a cell along an axis; boards run across the longer one.
static func _run(cell: Vector2i, axis: Vector2i) -> int:
	var length: int = 1
	for direction: Vector2i in [axis, -axis]:
		var next: Vector2i = cell + direction
		while length < 12 and tile_at(next) in ["b", "="]:
			length += 1
			next += direction
	return length


## Trees stand on their tile and rise about two tiles; draw in row-major order like walls.
static func draw_tree(canvas: CanvasItem, cell: Vector2i) -> void:
	var dest: Rect2 = Rect2((Vector2(cell) + Vector2(0.5, 0.5)) * TILE - TREE_ANCHOR, TREE_SIZE)
	var variant: int = noise(cell, 7) % TREE_VARIANTS
	if tile_at(cell) == "D":
		variant = DEAD_TREE_FIRST + noise(cell, 7) % DEAD_TREE_VARIANTS
	elif tile_at(cell) == "K":
		variant = DESERT_PLANT_FIRST + noise(cell, 7) % DESERT_PLANT_VARIANTS
	elif tile_at(cell) == "R":
		variant = ROCK_FIRST + noise(cell, 7) % ROCK_VARIANTS
	canvas.draw_texture_rect_region(OBJECTS, dest, Rect2(Vector2(variant * TREE_SIZE.x, 0), TREE_SIZE))


## A waystone (objects.png after the desert plants), standing on its tile like a tree.
const WAYSTONE_OBJECT: int = 8
## Boulders ("R", objects.png after the waystone): a rounded boulder, a pair of rocks, a mossy slab.
const ROCK_FIRST: int = 9
const ROCK_VARIANTS: int = 3


static func draw_waystone(canvas: CanvasItem, cell: Vector2i) -> void:
	var dest: Rect2 = Rect2((Vector2(cell) + Vector2(0.5, 0.5)) * TILE - TREE_ANCHOR, TREE_SIZE)
	canvas.draw_texture_rect_region(OBJECTS, dest, Rect2(Vector2(WAYSTONE_OBJECT * TREE_SIZE.x, 0), TREE_SIZE))


## Walls are drawn raised up and left; call in row-major order so nearer walls cover.
static func wall_mask(cell: Vector2i) -> int:
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		if tile_at(cell + bits[bit]) not in World.WALLS or tile_at(cell + bits[bit]).is_empty():
			mask |= 1 << bit
	return mask


static func wall_region(cell: Vector2i) -> Rect2:
	# Row 0: grey stone; row 1: obsidian; row 2: cave rock; row 3: thin walls ("#").
	if tile_at(cell) == "#":
		return Rect2(thin_wall_mask(cell) * WALL_SIZE, THIN_WALL_ROW * WALL_SIZE, WALL_SIZE, WALL_SIZE)
	var row: int = 1 if tile_at(cell) == "O" else 2
	return Rect2(wall_mask(cell) * WALL_SIZE, row * WALL_SIZE, WALL_SIZE, WALL_SIZE)


## A thin wall's connected sides: walls, and doorways (so a door fills the gap exactly).
static func thin_wall_mask(cell: Vector2i) -> int:
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		var next: Vector2i = cell + bits[bit]
		var tile: String = tile_at(next)
		if (not tile.is_empty() and tile in World.WALLS) or Buildings.is_door(World.terrain, next):
			mask |= 1 << bit
	return mask


static func draw_wall(canvas: CanvasItem, cell: Vector2i) -> void:
	var dest: Rect2 = Rect2(Vector2(cell) * TILE - Vector2.ONE * WALL_RAISE, Vector2.ONE * WALL_SIZE)
	canvas.draw_texture_rect_region(WALLS, dest, wall_region(cell))


## A building's pitched roof (roof_art.gd), rasterized the first time it is drawn.
static func draw_roof(canvas: CanvasItem, index: int, building: Dictionary, alpha: float) -> void:
	if not _roofs.has(index):
		_roofs[index] = RoofArt.build(building, ROOFS)
	canvas.draw_texture(_roofs[index]["texture"], _roofs[index]["origin"], Color(1, 1, 1, alpha))


## A piece of shop or bank furniture standing on its tile.
static func draw_furniture(canvas: CanvasItem, cell: Vector2i, kind: String) -> void:
	var index: int = maxi(0, FURNITURE.find(kind))
	canvas.draw_texture_rect_region(FURNITURE_SHEET, Rect2(Vector2(cell) * TILE - Vector2(0, 16), Vector2(32, 48)),
		Rect2(index * TILE, 0, TILE, 48))


## A shop or bank sign ({cell, outward, kind} from World.SIGNS) on the wall beside its door.
static func draw_sign(canvas: CanvasItem, sign: Dictionary) -> void:
	var centre: Vector2 = Vector2(sign["cell"]) * TILE + SIGN_OFFSETS[sign["outward"]]
	var index: int = maxi(0, SIGN_KINDS.find(sign["kind"]))
	canvas.draw_texture_rect_region(SIGNS, Rect2(centre - Vector2(16, 16), Vector2(32, 32)), Rect2(index * TILE, 0, TILE, TILE))



## A wall torch on the south face of its wall cell; frame 0 is unlit, 1-3 flicker.
static func draw_torch(canvas: CanvasItem, cell: Vector2i, frame: int) -> void:
	var foot: Vector2 = Vector2(cell) * TILE + Vector2(16, 25)
	canvas.draw_texture_rect_region(TORCH, Rect2(foot - Vector2(8, 24), Vector2(16, 24)), Rect2(frame * 16, 0, 16, 24))


## Character sheets have five columns per facing: stand, step A, step B, attack wind-up, and
## strike. A view whose "attack_born" is recent plays the attack, turned toward its target.
const ATTACK_SECONDS: float = 0.4
const WIND_UP_SECONDS: float = 0.14


## The state to draw for a creature view at `time`: during an attack, a copy facing the
## target with "attack" set to the attack's age; otherwise the state itself.
static func posed(view: Dictionary, time: float) -> Dictionary:
	var age: float = time - float(view.get("attack_born", -100.0))
	if age < 0.0 or age >= ATTACK_SECONDS:
		return view["state"]
	var state: Dictionary = view["state"].duplicate()
	state["facing"] = view.get("attack_facing", state["facing"])
	state["attack"] = age
	return state


static func frame_region(facing: Vector2i, stride: float, attack: float = -1.0) -> Rect2:
	var column: int = 0
	if attack >= 0.0 and attack < ATTACK_SECONDS:
		column = 3 if attack < WIND_UP_SECONDS else 4
	elif stride > 0.0:
		column = 1 if stride < 0.5 else 2
	return Rect2(column * FRAME, maxi(0, DIRECTIONS.find(facing)) * FRAME, FRAME, FRAME)


## stride is the 0..1 progress of the current step, or 0 when standing still.
static func draw_actor(canvas: CanvasItem, center: Vector2, state: Dictionary, local: bool, stride: float = 0.0,
		tint: Color = Color.TRANSPARENT) -> void:
	var facing: Vector2i = state["facing"]
	var equipment: Dictionary = state["equipment"]
	var source: Rect2 = frame_region(facing, stride, state.get("attack", -1.0))
	var dest: Rect2 = Rect2(center - FRAME_ANCHOR, Vector2.ONE * FRAME)
	if local:
		canvas.draw_texture_rect_region(MARKER, dest, source)
	var held: Texture2D = GEAR.get(equipment.get("main_hand", ""), null)
	var shield: Texture2D = GEAR.get(equipment.get("off_hand", ""), null)
	if held != null and facing == Vector2i.UP:
		canvas.draw_texture_rect_region(held, dest, source)
	if shield != null and facing.x != 0:
		canvas.draw_texture_rect_region(shield, dest, source)
	var cape: Texture2D = GEAR.get(equipment.get("cape", ""), null)
	var outfit: Texture2D = OUTFITS.get(equipment.get("armor", ""), null)
	if outfit != null:
		# Painted outfits include their own cloak, so a worn cape is not drawn over them.
		canvas.draw_texture_rect_region(outfit, dest, source)
		_draw_hands(canvas, dest, source, facing, held, shield)
		return
	var cloth: Color = tint if tint.a > 0.0 else COLORS[int(state["id"]) % COLORS.size()]
	canvas.draw_texture_rect_region(BODY, dest, source)
	for slot: String in ["legs", "boots"]:
		var worn: Texture2D = GEAR.get(equipment.get(slot, ""), null)
		if worn != null:
			canvas.draw_texture_rect_region(worn, dest, source)
	canvas.draw_texture_rect_region(CLOTH, dest, source, cloth)
	if cape != null and facing != Vector2i.UP:
		canvas.draw_texture_rect_region(cape, dest, source)
	var armor: Texture2D = GEAR.get(equipment.get("armor", ""), null)
	if armor != null:
		canvas.draw_texture_rect_region(armor, dest, source)
	if cape != null and facing == Vector2i.UP:
		canvas.draw_texture_rect_region(cape, dest, source)
	var helmet: Texture2D = GEAR.get(equipment.get("helmet", ""), null)
	if helmet != null:
		canvas.draw_texture_rect_region(helmet, dest, source)
	_draw_hands(canvas, dest, source, facing, held, shield)


## Front-held shields and weapons (weapons held behind when facing up are drawn first).
static func _draw_hands(canvas: CanvasItem, dest: Rect2, source: Rect2, facing: Vector2i, held: Texture2D,
		shield: Texture2D) -> void:
	if shield != null and facing.x == 0:
		canvas.draw_texture_rect_region(shield, dest, source)
	if held != null and facing != Vector2i.UP:
		canvas.draw_texture_rect_region(held, dest, source)


static func item_region(kind: String) -> Rect2:
	return Rect2(maxi(0, ITEM_ORDER.find(kind)) * TILE, 0, TILE, TILE)


## Draws an item icon centred on a 32-pixel slot or ground tile.
static func draw_item(canvas: CanvasItem, center: Vector2, kind: String, tint: Color = Color.WHITE) -> void:
	var dest := Rect2(center - Vector2.ONE * TILE / 2.0, Vector2.ONE * TILE)
	if ICONS.has(kind):
		canvas.draw_texture_rect(ICONS[kind], dest, false, tint)
		return
	canvas.draw_texture_rect_region(ITEM_ICONS, dest, item_region(kind), tint)


## A stack count in the bottom-right corner (right-aligned at `corner`).
static func draw_count(canvas: CanvasItem, corner: Vector2, count: int) -> void:
	var font: Font = ThemeDB.fallback_font
	var text: String = str(count)
	var at: Vector2 = corner - Vector2(font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9).x, 0)
	canvas.draw_string_outline(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9, 3, OUTLINE)
	canvas.draw_string(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9, Color("#f2e6c4"))


static func draw_slot_hint(canvas: CanvasItem, center: Vector2, slot: String) -> void:
	for kind: String in ITEM_ORDER:
		if World.fits(kind, slot):
			draw_item(canvas, center, kind, Color(0, 0, 0, 0.35))
			return


## Draws a monster from game/data/monsters.gd; humanoids reuse the character layers and gear.
static func draw_monster(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float) -> void:
	var definition: Dictionary = Monsters.MONSTERS.get(state["kind"], {})
	if definition.is_empty():
		return
	canvas.draw_set_transform(center + FEET, 0.0, Vector2.ONE * definition["size"])
	if definition["look"] == "humanoid":
		draw_actor(canvas, -FEET, {"id": 0, "facing": state["facing"], "equipment": definition.get("gear", {}),
			"attack": state.get("attack", -1.0)}, false, stride, definition["color"])
	else:
		var source: Rect2 = frame_region(state["facing"], stride)
		var dest := Rect2(-FRAME_ANCHOR - FEET, Vector2.ONE * FRAME)
		canvas.draw_texture_rect_region(MONSTER_SHEETS[definition["look"]], dest, source, definition["color"])
		canvas.draw_texture_rect_region(MONSTER_DETAILS[definition["look"]], dest, source)
	canvas.draw_set_transform(Vector2.ZERO)


## Tibia-style name and health bar above a creature; the bar turns yellow, then red.
static func draw_nameplate(canvas: CanvasItem, center: Vector2, text: String, health: int, max_health: int,
		height: float = 1.0, skull: String = "", name_color: Color = Color.TRANSPARENT, party: String = "",
		compact: bool = false) -> void:
	var font: Font = ThemeDB.fallback_font
	var top: float = center.y - 30.0 - 12.0 * (height - 1.0) + (4.0 * height if compact else 0.0)
	var fraction: float = clampf(float(health) / maxf(1.0, max_health), 0.0, 1.0)
	var color: Color = Color("#5ad04a") if fraction > 0.6 else (Color("#e0c040") if fraction > 0.3 else Color("#e04a3a"))
	var width: float = font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, 8).x
	var at := Vector2(center.x - width / 2.0, top - 4.0)
	canvas.draw_string_outline(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 8, 3, OUTLINE)
	canvas.draw_string(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 8, name_color if name_color.a > 0.0 else color)
	canvas.draw_rect(Rect2(center.x - 13, top - 1, 26, 4), OUTLINE)
	canvas.draw_rect(Rect2(center.x - 12, top, 24.0 * fraction, 2), color)
	if not skull.is_empty():
		draw_skull(canvas, Vector2(center.x + 18, top), skull)
	if not party.is_empty():
		draw_party_mark(canvas, Vector2(center.x - 18, top), party)


## Party shield beside the nameplate: blue for your party, gold-rimmed for its leader and
## outlined for a pending invitation.
static func draw_party_mark(canvas: CanvasItem, at: Vector2, party: String) -> void:
	var shield := PackedVector2Array([at + Vector2(-4, -4), at + Vector2(4, -4), at + Vector2(4, 1),
		at + Vector2(0, 5), at + Vector2(-4, 1)])
	var fill: Color = Color("#3a7ad0") if party != "invited" else Color(0.23, 0.48, 0.82, 0.25)
	canvas.draw_colored_polygon(shield, fill)
	shield.append(shield[0])
	canvas.draw_polyline(shield, Color("#e8c050") if party == "leader" else OUTLINE, 1.0)


## Name colour for a monster compared with your level: white is fair, yellow is tough,
## red is likely deadly.
static func danger_color(monster_level: int, player_level: int) -> Color:
	var gap: int = monster_level - player_level
	if gap >= 5:
		return Color("#ff6a50")
	if gap >= 2:
		return Color("#f0d060")
	return Color("#f2f0e6")


## A small PvP skull: white for attacking unmarked players, red after three unjustified kills.
static func draw_skull(canvas: CanvasItem, at: Vector2, skull: String) -> void:
	var bone: Color = Color("#f2f0e6") if skull == "white" else Color("#e0362a")
	canvas.draw_circle(at, 4.5, OUTLINE)
	canvas.draw_rect(Rect2(at + Vector2(-3, 1), Vector2(6, 4.5)), OUTLINE)
	canvas.draw_circle(at, 3.5, bone)
	canvas.draw_rect(Rect2(at + Vector2(-2, 1), Vector2(4, 3)), bone)
	canvas.draw_rect(Rect2(at + Vector2(-2, -1), Vector2(1.5, 1.5)), OUTLINE)
	canvas.draw_rect(Rect2(at + Vector2(0.5, -1), Vector2(1.5, 1.5)), OUTLINE)


# ---------------------------------------------------------------- glow (additive pass)

## Halos of worn relics; call on an additive canvas with the same centre as draw_actor.
static func draw_actor_glow(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float, strength: float) -> bool:
	var source: Rect2 = frame_region(state["facing"], stride, state.get("attack", -1.0))
	var dest: Rect2 = Rect2(center - FRAME_ANCHOR, Vector2.ONE * FRAME)
	var glowing: bool = false
	for slot: String in VISIBLE_SLOTS:
		var kind: String = String(state["equipment"].get(slot, ""))
		if GEAR_GLOW.has(kind):
			canvas.draw_texture_rect_region(GEAR_GLOW[kind], dest, source, Color(World.ITEMS[kind]["glow"], strength))
			glowing = true
	return glowing


## Boss halos: glowing relic gear on humanoids, or the creature's own "glow" colour.
static func draw_monster_glow(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float, strength: float) -> bool:
	var definition: Dictionary = Monsters.MONSTERS.get(state["kind"], {})
	if definition.is_empty():
		return false
	var glowing: bool = false
	canvas.draw_set_transform(center + FEET, 0.0, Vector2.ONE * definition["size"])
	if definition["look"] == "humanoid":
		glowing = draw_actor_glow(canvas, -FEET, {"facing": state["facing"], "equipment": definition.get("gear", {}),
			"attack": state.get("attack", -1.0)}, stride, strength)
	elif definition.has("glow") and MONSTER_GLOW.has(definition["look"]):
		var dest := Rect2(-FRAME_ANCHOR - FEET, Vector2.ONE * FRAME)
		canvas.draw_texture_rect_region(MONSTER_GLOW[definition["look"]], dest, frame_region(state["facing"], stride),
			Color(definition["glow"], strength))
		glowing = true
	canvas.draw_set_transform(Vector2.ZERO)
	return glowing


static func draw_item_glow(canvas: CanvasItem, center: Vector2, entry: String, strength: float) -> bool:
	var kind: String = World.kind_of(entry)
	if not World.ITEMS.has(kind) or not World.ITEMS[kind].has("glow"):
		return false
	canvas.draw_texture_rect_region(ITEM_GLOW, Rect2(center - Vector2.ONE * TILE / 2.0, Vector2.ONE * TILE),
		item_region(kind), Color(World.ITEMS[kind]["glow"], strength))
	return true
