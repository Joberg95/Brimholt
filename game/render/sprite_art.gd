## Edge overlay order in the tile sheet: north, east, south, west.
const EDGES: Array[Vector2i] = [Vector2i.UP, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.LEFT]


static func _item_order() -> Array[String]:
	var order: Array[String] = []
	order.assign(World.ITEMS.keys())
	return order


static func _gear_sheets(suffix: String = "") -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in World.ITEMS:
		if VISIBLE_SLOTS.has(World.ITEMS[kind]["slot"]) and (suffix.is_empty() or World.ITEMS[kind].has("glow")):
			var path: String = "res://assets/sprites/gear/%s%s.png" % [kind, suffix]
			if ResourceLoader.exists(path):
				sheets[kind] = load(path)
	return sheets


static func _creature_sheets(suffix: String = "") -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in Monsters.MONSTERS:
		var path: String = "res://assets/sprites/creatures/%s%s.png" % [kind, suffix]
		if ResourceLoader.exists(path):
			sheets[kind] = load(path)
	return sheets


## The coins.png frame for a stack of `count` coins.
static func coin_stage(count: int) -> int:
	var stage: int = 0
	for index: int in COIN_STAGES.size():
		if count >= COIN_STAGES[index]:
			stage = index
	return stage


static func _anim_sheets() -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in World.ITEMS:
		var path: String = "res://assets/sprites/items_anim/%s.png" % kind
		if ResourceLoader.exists(path):
			sheets[kind] = load(path)
	return sheets


static func _mount_sheets(suffix: String = "") -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in World.ITEMS:
		var path: String = "res://assets/sprites/mounts/%s%s.png" % [kind, suffix]
		if World.ITEMS[kind]["slot"] == "mount" and ResourceLoader.exists(path):
			sheets[kind] = load(path)
	return sheets


## How far up the rider of `state` sits this frame (0 when walking): the mount's saddle height,
## one more pixel on its step frames. Only above ground (World.riding) and with a mount sheet.
static func rider_lift(state: Dictionary, stride: float) -> float:
	var mount: String = String(state.get("equipment", {}).get("mount", ""))
	if not state.has("cell") or not MOUNTS.has(mount) or not World.riding(state["equipment"], state["cell"]):
		return 0.0
	return RIDER_LIFT.get(String(World.ITEMS[mount]["look"]).get_slice("+", 0), 8) + (1.0 if stride > 0.0 else 0.0)


static func tile_at(cell: Vector2i) -> String:
	return World.terrain(cell)


static func noise(cell: Vector2i, salt: int) -> int:
	return absi((cell.x * 73856093) ^ (cell.y * 19349663) ^ (salt * 83492791)) % 1000003


static func _tile_region(index: int) -> Rect2:
	return TILE_REGIONS[index]


static func _tile_regions() -> Array[Rect2]:
	var regions: Array[Rect2] = []
	for index: int in 80:
		regions.append(Rect2(Vector2(index % 4, index / 4) * TILE, Vector2.ONE * TILE))
	return regions


## Floor data for game/render/terrain.gdshader, one texel per cell packed little-endian in an int:
## R the floor tile; G an overlay tile drawn over the quarters set in B's low four bits (a pier's
## planks, a building's floor beside its wall; NO_TILE for none); B's high four bits the kerbs by
## side (EDGES order); A the blend (floor_blend). R = NO_TILE is the void, drawn black.
static func floor_texel(cell: Vector2i) -> int:
	var tile: String = tile_at(cell)
	if tile == " " or tile.is_empty():
		return NO_TILE
	var base: int
	var overlay: int = NO_TILE
	var bits: int = 0
	if tile == "#":
		var outside: String = "."
		var inside: String = ""
		for side: Vector2i in EDGES:
			var next: String = tile_at(cell + side)
			# Never a stairway: a wall beside one would show a second hole under it.
			if next.is_empty() or next in World.WALLS or next in World.TREES or next in ["~", "b", "v", "^", " "]:
				continue
			if _inner(cell + side):
				inside = next if inside.is_empty() and next in World.LAND and next != "v" else inside
			elif outside == ".":
				outside = next
		# A wall with nothing open on its outer side (a dungeon's outer wall) stands on its inside floor.
		if outside == "." and not inside.is_empty() and not EDGES.any(func(side: Vector2i) -> bool: return tile_at(cell + side) == "."):
			outside = inside
		# Below ground there is no grass: a corner wall of the sewers stands on the floor beside it.
		if outside == "." and inside.is_empty() and Atlas.below_ground(cell):
			for corner: Vector2i in [Vector2i(-1, -1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(1, 1)]:
				var floor_beside: String = tile_at(cell + corner)
				if floor_beside in World.LAND and floor_beside not in ["v", "^"]:
					outside = floor_beside
					break
		base = _floor_index(outside, cell, 0.0)
		# A carpet never runs under a wall: a keep's wall shows its sandstone floor inside.
		overlay = _floor_index("=" if inside.is_empty() else ("F" if inside == "Y" else inside), cell, 0.0, true)
		var quarter: int = 0
		for corner: Vector2i in [Vector2i(-1, -1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(1, 1)]:
			if _inner(cell + Vector2i(corner.x, 0)) or _inner(cell + Vector2i(0, corner.y)) or _inner(cell + corner):
				bits |= 1 << quarter
			quarter += 1
		if bits == 0:
			overlay = NO_TILE
	elif tile == "v" or tile == "^":
		base = _floor_index(ground_under(cell), cell, 0.0)
		overlay = way_tile(cell)
		bits = 15
	else:
		base = _floor_index(tile, cell, 0.0)
		if tile == "b":
			overlay = (PLANK_TILE if _run(cell, Vector2i.DOWN) > _run(cell, Vector2i.RIGHT) else VERTICAL_PLANK_TILE) \
				+ noise(cell, 6) % 2
			bits = 15
		elif tile == "=" and World.OVERWORLD.has_point(cell):
			for side: int in EDGES.size():
				if tile_at(cell + EDGES[side]) in CURBED:
					bits |= 16 << side
	return base | overlay << 8 | bits << 16 | floor_blend(base) << 24


## Inside a building or a castle keep (its sandstone floor or carpet): a wall's floor shows the
## inside there and the street or ground outside.
static func _inner(cell: Vector2i) -> bool:
	return World.ROOM_AT.has(cell) or tile_at(cell) in ["F", "Y"]


## How a floor tile meets its neighbours in terrain.gdshader: bits 0-3 a priority (natural ground
## of a higher priority spills over a lower one in a ragged edge; 0 is a built floor that never
## blends), BLEND_WATER for animated water with shore foam, BLEND_SWAY for grass that sways.
static func floor_blend(index: int) -> int:
	if index < DIRT_TILE:
		return 8 | BLEND_SWAY
	for start: int in FLOOR_PRIORITY:
		if index >= start and index < start + 4:
			return FLOOR_PRIORITY[start]
	return 0


## The tile index of a floor; `indoors` marks a building's floor seen beside its wall.
static func _floor_index(tile: String, cell: Vector2i, time: float, indoors: bool = false) -> int:
	var index: int = GRASS_TILES[noise(cell, 1) % GRASS_TILES.size()]
	if tile == ",":
		index = DIRT_TILE + noise(cell, 2) % 4
	elif tile == "~" or tile == "b":
		index = WATER_TILE + (int(time * 3.0) + noise(cell, 3)) % 4
	elif tile == ":" or tile == "K":
		index = SAND_TILE + noise(cell, 4) % 4
	elif tile == "=" and theme_at(cell) == "cellar":
		index = CELLAR_FLOOR_TILE + noise(cell, 13) % 4
	elif tile == "=" and Biomes.in_isles(cell):
		index = PLANK_TILE + noise(cell, 6) % 2 if indoors or World.ROOM_AT.has(cell) else SNOW_COBBLE_TILE + noise(cell, 5) % 4
	elif tile == "=" and Biomes.in_sunreach(cell):
		index = FLAG_TILE + noise(cell, 5) % 4
	elif tile == "s" or tile == "P":
		index = SNOW_TILE + noise(cell, 15) % 4
	elif tile == "=" or tile == "W":
		index = COBBLE_TILE + noise(cell, 5) % 4
	elif tile == "d" or tile == "D" or tile == "O":
		index = DUSK_TILE + noise(cell, 8) % 4
	elif tile == "o":
		index = obsidian_variant(cell)
	elif tile == "L":
		index = GRAVEL_TILE + noise(cell, 12) % 4
	elif tile == "c" and Caves.at(cell) == ICE_CAVE:
		# The Rimewater Trench lies under the sea ice: its floor is packed snow and ice.
		index = SNOW_TILE + noise(cell, 15) % 4
	elif (tile == "c" or tile == "C" and not World.OVERWORLD.has_point(cell)) and rock_cave(cell):
		index = CAVE_EARTH_TILE + noise(cell, 11) % 4
	elif tile == "c" or tile == "C" and not World.OVERWORLD.has_point(cell):
		# Rock outcrops on the overworld stand on grass; cave rock in dungeons on cave floor.
		index = CAVE_TILE + noise(cell, 11) % 4
	elif tile == "F":
		index = FLAG_TILE + (noise(cell, 16) % 7) % 4
	elif tile == "Y":
		var open: int = 0
		for side: int in 4:
			if tile_at(cell + [Vector2i.UP, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.LEFT][side]) != "Y":
				open |= 1 << side
		index = CARPET_TILE + open
	elif tile == "m" or tile == "U":
		index = BOG_TILE + noise(cell, 14) % 4
	return index


## The ground a stairway cell stands on: the walkable ground most common round it (floor, street,
## grass, sand...), so the way down or up is set into it and the shader blends it like its
## neighbours.
static func ground_under(cell: Vector2i) -> String:
	var counts: Dictionary = {}
	for dy: int in range(-1, 2):
		for dx: int in range(-1, 2):
			var next: String = tile_at(cell + Vector2i(dx, dy))
			if not next.is_empty() and next in World.LAND and next not in ["v", "^"]:
				counts[next] = counts.get(next, 0) + (2 if dx == 0 or dy == 0 else 1)
	var best: String = "."
	for kind: String in counts:
		if counts[kind] > counts.get(best, 0):
			best = kind
	return best


## The overlay of a stairway: into a built dungeon (stone walls, like the town cellar and the
## crypt) a ladder opening, into a cave (rock walls) or an elite cave a hole in the ground; out of
## a built dungeon a ladder up, out of a cave rough steps.
static func way_tile(cell: Vector2i) -> int:
	if tile_at(cell) == "^" and World.HOLES.has(cell):
		# Between floors: a ladder in or up to a town (a sewer's, a house's), rough steps elsewhere.
		var town: bool = World.zone_at(cell).get("town", false) or World.zone_at(World.HOLES[cell]).get("town", false)
		return STAIRS_UP_TILE if town else ROCK_STEPS_TILE
	if tile_at(cell) == "^":
		var place: Array = World.dungeon_at(cell)
		return STAIRS_UP_TILE if not place.is_empty() and Dungeons.DUNGEONS[place[0]]["wall"] == "#" else ROCK_STEPS_TILE
	if World.DUNGEON_ENTRANCES.has(cell):
		return STAIRS_DOWN_TILE if Dungeons.DUNGEONS[World.DUNGEON_ENTRANCES[cell]]["wall"] == "#" else CAVE_HOLE_TILE
	if World.CAVE_MOUTHS.has(cell):
		return CAVE_HOLE_TILE
	return STAIRS_DOWN_TILE if World.zone_at(cell).get("town", false) else CAVE_HOLE_TILE


## Obsidian flagstones; the rune-carved stone (variant 0) appears on about one tile in twelve.
static func obsidian_variant(cell: Vector2i) -> int:
	return OBSIDIAN_TILE + (0 if noise(cell, 9) % 12 == 0 else 1 + noise(cell, 10) % 3)


## Length of the pier or bridge through a cell along an axis; boards run across the longer one.
static func _run(cell: Vector2i, axis: Vector2i) -> int:
	var length: int = 1
	for direction: Vector2i in [axis, -axis]:
		var next: Vector2i = cell + direction
		while length < 12 and tile_at(next) in ["b", "="]:
			length += 1
			next += direction
	return length


## Trees stand on their tile and rise about two tiles; draw in row-major order like walls.
static func draw_tree(canvas: CanvasItem, cell: Vector2i) -> void:
	var dest: Rect2 = Rect2((Vector2(cell) + Vector2(0.5, 0.5)) * TILE - TREE_ANCHOR, TREE_SIZE)
	if tile_at(cell) == "U":
		canvas.draw_texture_rect_region(MUSHROOMS, dest,
			Rect2(Vector2(noise(cell, 7) % MUSHROOM_VARIANTS * TREE_SIZE.x, 0), TREE_SIZE))
		return
	if tile_at(cell) == "P":
		canvas.draw_texture_rect_region(FIRS, dest, Rect2(Vector2(noise(cell, 7) % FIR_VARIANTS * TREE_SIZE.x, 0), TREE_SIZE))
		return
	if tile_at(cell) == "T" and Biomes.in_sunreach(cell):
		canvas.draw_texture_rect_region(PALMS, dest, Rect2(Vector2(noise(cell, 7) % PALM_VARIANTS * TREE_SIZE.x, 0), TREE_SIZE))
		return
	var variant: int = noise(cell, 7) % TREE_VARIANTS
	if tile_at(cell) == "D":
		variant = DEAD_TREE_FIRST + noise(cell, 7) % DEAD_TREE_VARIANTS
	elif tile_at(cell) == "K":
		variant = DESERT_PLANT_FIRST + noise(cell, 7) % DESERT_PLANT_VARIANTS
	elif tile_at(cell) == "R":
		variant = ROCK_FIRST + noise(cell, 7) % ROCK_VARIANTS
	canvas.draw_texture_rect_region(OBJECTS, dest, Rect2(Vector2(variant * TREE_SIZE.x, 0), TREE_SIZE))


## A waystone (objects.png after the desert plants), standing on its tile like a tree.
const WAYSTONE_OBJECT: int = 8
## Boulders ("R", objects.png after the waystone): a rounded boulder, a pair of rocks, a mossy slab.
const ROCK_FIRST: int = 9
const ROCK_VARIANTS: int = 3


static func draw_waystone(canvas: CanvasItem, cell: Vector2i) -> void:
	var dest: Rect2 = Rect2((Vector2(cell) + Vector2(0.5, 0.5)) * TILE - TREE_ANCHOR, TREE_SIZE)
	canvas.draw_texture_rect_region(OBJECTS, dest, Rect2(Vector2(WAYSTONE_OBJECT * TREE_SIZE.x, 0), TREE_SIZE))


## Walls are drawn raised up and left; call in row-major order so nearer walls cover.
static func wall_mask(cell: Vector2i) -> int:
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		if tile_at(cell + bits[bit]) not in World.WALLS or tile_at(cell + bits[bit]).is_empty():
			mask |= 1 << bit
	return mask


## The sheet region of a wall cell's sprite, in wall_sheet(cell), drawn wall_raise(cell) px up-left.
static func wall_region(cell: Vector2i) -> Rect2:
	# House walls ("#"): house_walls.png. walls.png rows: 0 grey stone, 1 obsidian, 2 cave rock,
	# 4 cliffs ("L"), 5 rock outcrops ("C" on the overworld).
	if tile_at(cell) == "#":
		var mask: int = thin_wall_mask(cell)
		# Some straight overworld walls get a window (frames WINDOW_FRAME: south, then east face).
		if wall_sheet(cell) in [SANDSTONE_WALLS, HOUSE_WALLS, LOG_WALLS] and World.OVERWORLD.has_point(cell) \
				and mask in [5, 10] and noise(cell, 17) % 3 == 0:
			return Rect2((WINDOW_FRAME + (1 if mask == 5 else 0)) * HOUSE_SIZE, 0, HOUSE_SIZE, HOUSE_SIZE)
		return Rect2(mask * HOUSE_SIZE, 0, HOUSE_SIZE, HOUSE_SIZE)
	var row: int = {"O": 1, "L": 4}.get(tile_at(cell), 2)
	if row == 2 and World.OVERWORLD.has_point(cell):
		row = 5
	return Rect2(wall_mask(cell) * WALL_SIZE, row * WALL_SIZE, WALL_SIZE, WALL_SIZE)


## An ore vein glittering in a rock block's cliff face (drawn over the block).
static func draw_ore(canvas: CanvasItem, cell: Vector2i, band: int, glint: bool) -> void:
	var dest: Rect2 = Rect2(Vector2(cell) * TILE - Vector2.ONE * WALL_RAISE, Vector2.ONE * WALL_SIZE)
	canvas.draw_texture_rect_region(ORES, dest, Rect2(band * WALL_SIZE, (1 if glint else 0) * WALL_SIZE, WALL_SIZE, WALL_SIZE))


## Whether a castle wall cell belongs to a tower: some 2x2 square of castle wall holds it.
static func tower(cell: Vector2i) -> bool:
	if tile_at(cell) != "W":
		return false
	for corner: Vector2i in [Vector2i(-1, -1), Vector2i(0, -1), Vector2i(-1, 0), Vector2i(0, 0)]:
		var square: Vector2i = cell + corner
		if tile_at(square) == "W" and tile_at(square + Vector2i.RIGHT) == "W" and tile_at(square + Vector2i.DOWN) == "W" \
				and tile_at(square + Vector2i.ONE) == "W":
			return true
	return false


## A castle wall's open sides (1 N, 2 W, 4 S, 8 E): sides not joined to more castle wall, or for a
## tower, to more tower (so a tower shows its full height against the wall beside it).
static func castle_mask(cell: Vector2i) -> int:
	var high: bool = tower(cell)
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		var next: Vector2i = cell + bits[bit]
		if not (tower(next) if high else tile_at(next) == "W"):
			mask |= 1 << bit
	return mask


## Natural rock, drawn as the mountains' seamless rock blocks: mountains ("L"), the overworld's
## rock outcrops, and the rock of every cave ("C").
static func natural_rock(cell: Vector2i) -> bool:
	var tile: String = tile_at(cell)
	return tile == "L" or tile == "C"


## A cave hewn by nature, not built: an elite or farming cave, the underground's tunnels, or a
## dungeon with rock walls.
static func rock_cave(cell: Vector2i) -> bool:
	if not Caves.at(cell).is_empty() or Atlas.below_ground(cell):
		return true
	var place: Array = World.dungeon_at(cell)
	return not place.is_empty() and Dungeons.DUNGEONS[place[0]]["wall"] in ["L", "C"]


## A rock block's open sides (1 N, 2 W, 4 S, 8 E): every side not joined to more natural rock.
static func rock_mask(cell: Vector2i) -> int:
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		if not natural_rock(cell + bits[bit]):
			mask |= 1 << bit
	return mask


## A thin wall's connected sides: walls, and building doorways (so a door fills the gap exactly).
static func thin_wall_mask(cell: Vector2i) -> int:
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		var next: Vector2i = cell + bits[bit]
		var tile: String = tile_at(next)
		# Only a building's doorway joins the wall over it: a one-tile corridor between two walls
		# (dungeons, alleys) looks like a doorway too, but there the walls stay apart.
		if (not tile.is_empty() and tile in World.WALLS) or (World.ROOM_AT.has(next) or castle_stone(next) and World.OVERWORLD.has_point(next)) 				and Buildings.is_door(World.terrain, next):
			mask |= 1 << bit
	return mask


static func draw_wall(canvas: CanvasItem, cell: Vector2i) -> void:
	if tile_at(cell) == "W":
		var high: bool = tower(cell)
		var lift: int = (TOWER_RAISE if high else CASTLE_RAISE) + CASTLE_PAD
		var size: float = TILE + lift
		var sand: bool = Biomes.in_sunreach(cell)
		var sheet: Texture2D = (SANDSTONE_CASTLE_TOWERS if high else SANDSTONE_CASTLE_WALLS) if sand 			else (CASTLE_TOWERS if high else CASTLE_WALLS)
		canvas.draw_texture_rect_region(sheet,
			Rect2(Vector2(cell) * TILE - Vector2.ONE * lift, Vector2.ONE * size), Rect2(castle_mask(cell) * size, 0, size, size))
		return
	var raise: float = wall_raise(cell)
	var dest: Rect2 = Rect2(Vector2(cell) * TILE - Vector2.ONE * raise, Vector2.ONE * (TILE + raise))
	if natural_rock(cell):
		# Natural rock: a block of the seamless rock texture with cliff faces where it meets open ground.
		var part: int = posmod(cell.x, ROCK_SPAN) + posmod(cell.y, ROCK_SPAN) * ROCK_SPAN
		canvas.draw_texture_rect_region(MOUNTAINS if World.OVERWORLD.has_point(cell) else CAVE_ROCK, dest, Rect2(rock_mask(cell) * WALL_SIZE, part * WALL_SIZE, WALL_SIZE, WALL_SIZE))
		return
	canvas.draw_texture_rect_region(wall_sheet(cell), dest, wall_region(cell))
	if tile_at(cell) == "#" and tile_at(cell + Vector2i.RIGHT) == "#" and tile_at(cell + Vector2i.DOWN) == "#" 			and tile_at(cell + Vector2i.ONE) == "#":
		canvas.draw_texture_rect_region(wall_sheet(cell), dest, Rect2(HOUSE_FILL * HOUSE_SIZE, 0, HOUSE_SIZE, HOUSE_SIZE))


## The sheet a wall cell is drawn from (house_walls.png for "#", else walls.png).
static func wall_sheet(cell: Vector2i) -> Texture2D:
	if tile_at(cell) != "#":
		return WALLS
	if Biomes.in_sunreach(cell):
		return SANDSTONE_WALLS
	if castle_stone(cell):
		return FIELDSTONE_WALLS
	if Biomes.in_isles(cell):
		return LOG_WALLS
	return CELLAR_WALLS if theme_at(cell) == "cellar" else HOUSE_WALLS


## Whether a wall or doorway belongs to a castle keep: a sandstone floor or carpet beside it.
static func castle_stone(cell: Vector2i) -> bool:
	for dy: int in range(-1, 2):
		for dx: int in range(-1, 2):
			if tile_at(cell + Vector2i(dx, dy)) in ["F", "Y"]:
				return true
	return false


## A decoration on a wall's visible face, hung like a sign (SIGN_OFFSETS for a south-facing door).
static func draw_wall_decor(canvas: CanvasItem, cell: Vector2i, kind: String) -> void:
	var centre: Vector2 = Vector2(cell) * TILE + SIGN_OFFSETS[Vector2i.DOWN]
	var index: int = maxi(0, WALL_DECOR.find(kind))
	canvas.draw_texture_rect_region(WALL_DECOR_SHEET, Rect2(centre - Vector2(16, 16), Vector2(32, 32)), Rect2(index * TILE, 0, TILE, TILE))


## The theme of the dungeon copy a cell lies in ("" on the overworld).
static func theme_at(cell: Vector2i) -> String:
	var place: Array = World.dungeon_at(cell)
	return "" if place.is_empty() else Dungeons.theme_at(place[0])


## How far up and left a wall cell's sprite is raised: a full tile for house walls.
static func wall_raise(cell: Vector2i) -> float:
	return HOUSE_RAISE if tile_at(cell) == "#" else WALL_RAISE


## A doorway in a house wall: the wall runs on over it with a door standing ajar in its visible
## face (south for a west-east wall, east for a north-south one), drawn like a wall in depth order.
static func draw_door(canvas: CanvasItem, cell: Vector2i) -> void:
	var vertical: bool = tile_at(cell + Vector2i.UP) in World.WALLS and not tile_at(cell + Vector2i.UP).is_empty()
	var sheet: Texture2D = SANDSTONE_WALLS if Biomes.in_sunreach(cell) else FIELDSTONE_WALLS if castle_stone(cell) else HOUSE_WALLS
	canvas.draw_texture_rect_region(sheet,
		Rect2(Vector2(cell) * TILE - Vector2.ONE * HOUSE_RAISE, Vector2.ONE * HOUSE_SIZE),
		Rect2((HOUSE_DOOR + (1 if vertical else 0)) * HOUSE_SIZE, 0, HOUSE_SIZE, HOUSE_SIZE))


## A building's pitched roof (roof_art.gd), rasterized the first time it is drawn.
static func draw_roof(canvas: CanvasItem, index: int, building: Dictionary, alpha: float) -> void:
	if not _roofs.has(index):
		_roofs[index] = RoofArt.build(building, ROOFS)
	canvas.draw_texture(_roofs[index]["texture"], _roofs[index]["origin"], Color(1, 1, 1, alpha))


## A piece of shop or bank furniture standing on its tile.
static func draw_furniture(canvas: CanvasItem, cell: Vector2i, kind: String, time: float = 0.0) -> void:
	if kind == "fountain_basin":
		return
	if kind == "fountain":
		var frame: int = int(time * FOUNTAIN_FPS) % FOUNTAIN_FRAMES
		canvas.draw_texture_rect_region(FOUNTAIN_SHEET, Rect2(Vector2(cell) * TILE - Vector2(TILE, 80), Vector2(96, 112)),
			Rect2(frame * 96, 0, 96, 112))
		return
	var index: int = maxi(0, FURNITURE.find(kind))
	canvas.draw_texture_rect_region(FURNITURE_SHEET, Rect2(Vector2(cell) * TILE - Vector2(0, 16), Vector2(32, 48)),
		Rect2(index * TILE, 0, TILE, 48))


## A herb patch of a resource band on its tile (the variant picked by the cell).
static func draw_herb(canvas: CanvasItem, cell: Vector2i, band: int) -> void:
	var variant: int = band * 2 + (cell.x + cell.y) % 2
	canvas.draw_texture_rect_region(HERBS, Rect2(Vector2(cell) * TILE, Vector2(TILE, TILE)), Rect2(variant * TILE, 0, TILE, TILE))


## A shop or bank sign ({cell, outward, kind} from World.SIGNS) on the wall beside its door.
static func draw_sign(canvas: CanvasItem, sign: Dictionary) -> void:
	var centre: Vector2 = Vector2(sign["cell"]) * TILE + SIGN_OFFSETS[sign["outward"]]
	var index: int = maxi(0, SIGN_KINDS.find(sign["kind"]))
	canvas.draw_texture_rect_region(SIGNS, Rect2(centre - Vector2(16, 16), Vector2(32, 32)), Rect2(index * TILE, 0, TILE, TILE))



## A spell projectile at `at` (map pixels) flying along `direction`; false when its element has no
## sprite (melee strikes and tinted spells), so the caller draws the plain line instead.
static func draw_missile(canvas: CanvasItem, at: Vector2, direction: Vector2, element: String, age: float) -> bool:
	var row: int = MISSILE_ELEMENTS.find(element)
	if row < 0:
		return false
	var frame: int = int(age * 24.0) % MISSILE_FRAMES
	canvas.draw_set_transform(at, direction.angle(), Vector2.ONE)
	canvas.draw_texture_rect_region(SPELL_MISSILES, Rect2(-Vector2.ONE * MISSILE_SIZE / 2.0, Vector2.ONE * MISSILE_SIZE),
		Rect2(frame * MISSILE_SIZE, row * MISSILE_SIZE, MISSILE_SIZE, MISSILE_SIZE))
	canvas.draw_set_transform(Vector2.ZERO)
	return true


## One tile of a rune spell `age` seconds after it landed; false once it has played out. A held
## effect (HELD_FX) plays over its `life` instead.
static func draw_rune_fx(canvas: CanvasItem, cell: Vector2i, element: String, age: float, life: float = 0.0) -> bool:
	var row: int = RUNE_FX_ELEMENTS.find(element)
	var held: bool = element in HELD_FX and life > 0.0
	if row < 0 or age >= (life if held else RUNE_FX_SECONDS):
		return false
	var frame: int = mini(RUNE_FX_FRAMES - 1, floori(age / RUNE_FX_SECONDS * RUNE_FX_FRAMES))
	if held:
		frame = 0 if age < 0.15 else 3 if age > life - 0.4 else 1 + int(age / 0.5) % 2
	canvas.draw_texture_rect_region(RUNE_FX, Rect2(Vector2(cell) * TILE - Vector2(0, 6), Vector2.ONE * TILE),
		Rect2(frame * TILE, row * TILE, TILE, TILE))
	return true


## Character sheets have five columns per facing: stand, step A, step B, attack wind-up, and
## strike. A view whose "attack_born" is recent plays the attack, turned toward its target.
const ATTACK_SECONDS: float = 0.4
const WIND_UP_SECONDS: float = 0.14
const GATHER_SWING: float = 0.75


## The state to draw for a creature view at `time`: during an attack, a copy facing the
## target with "attack" set to the attack's age; otherwise the state itself.
static func posed(view: Dictionary, time: float) -> Dictionary:
	var age: float = time - float(view.get("attack_born", -100.0))
	if (age < 0.0 or age >= ATTACK_SECONDS) and view["state"].has("gathering"):
		# Gathering swings a tool (or the line) at the node every GATHER_SWING seconds.
		var swing: Dictionary = view["state"].duplicate()
		swing["attack"] = fmod(time, GATHER_SWING)
		return swing
	if age < 0.0 or age >= ATTACK_SECONDS:
		return view["state"]
	var state: Dictionary = view["state"].duplicate()
	state["facing"] = view.get("attack_facing", state["facing"])
	state["attack"] = age
	return state


static func frame_region(facing: Vector2i, stride: float, attack: float = -1.0) -> Rect2:
	var column: int = 0
	if attack >= 0.0 and attack < ATTACK_SECONDS:
		column = 3 if attack < WIND_UP_SECONDS else 4
	elif stride > 0.0:
		column = 1 if stride < 0.5 else 2
	return Rect2(column * FRAME, maxi(0, DIRECTIONS.find(facing)) * FRAME, FRAME, FRAME)


## stride is the 0..1 progress of the current step, or 0 when standing still.
static func draw_actor(canvas: CanvasItem, center: Vector2, state: Dictionary, local: bool, stride: float = 0.0,
		tint: Color = Color.TRANSPARENT) -> void:
	var facing: Vector2i = state["facing"]
	var equipment: Dictionary = state["equipment"]
	var source: Rect2 = frame_region(facing, stride, state.get("attack", -1.0))
	var dest: Rect2 = Rect2(center - FRAME_ANCHOR, Vector2.ONE * FRAME)
	if local:
		canvas.draw_texture_rect_region(MARKER, dest, source)
	var lift: float = rider_lift(state, stride)
	if lift <= 0.0:
		_draw_figure(canvas, dest, source, state, tint)
		return
	# Riding: the mount walks (attack frames show it standing), the rider sits still on top.
	var mount: String = equipment["mount"]
	var gait := Rect2(frame_region(facing, stride).position, Vector2.ONE * FRAME)
	canvas.draw_texture_rect_region(MOUNTS[mount], dest, gait)
	var seated: Rect2 = frame_region(facing, 0.0, state.get("attack", -1.0))
	var raised := Rect2(dest.position - Vector2(0, lift), dest.size)
	if facing.x == 0:
		seated.size.y = RIDER_CUT
		raised.size.y = RIDER_CUT
	_draw_figure(canvas, raised, seated, state, tint)
	canvas.draw_texture_rect_region(MOUNTS_FRONT[mount], dest, gait)


## The character itself (no ground marker or mount) into dest from the sheets' source frame.
static func _draw_figure(canvas: CanvasItem, dest: Rect2, source: Rect2, state: Dictionary, tint: Color) -> void:
	var facing: Vector2i = state["facing"]
	var equipment: Dictionary = state["equipment"]
	var held: Texture2D = GEAR.get(equipment.get("main_hand", ""), null)
	var shield: Texture2D = GEAR.get(equipment.get("off_hand", ""), null)
	if held != null and facing == Vector2i.UP:
		canvas.draw_texture_rect_region(held, dest, source)
	if shield != null and facing.x != 0:
		canvas.draw_texture_rect_region(shield, dest, source)
	var cape: Texture2D = GEAR.get(equipment.get("cape", ""), null)
	var cloth: Color = tint if tint.a > 0.0 else COLORS[int(state["id"]) % COLORS.size()]
	canvas.draw_texture_rect_region(BODY, dest, source)
	for slot: String in ["legs", "boots"]:
		var worn: Texture2D = GEAR.get(equipment.get(slot, ""), null)
		if worn != null:
			canvas.draw_texture_rect_region(worn, dest, source)
	canvas.draw_texture_rect_region(CLOTH, dest, source, cloth)
	if cape != null and facing != Vector2i.UP:
		canvas.draw_texture_rect_region(cape, dest, source)
	var armor: Texture2D = GEAR.get(equipment.get("armor", ""), null)
	if armor != null:
		canvas.draw_texture_rect_region(armor, dest, source)
	if cape != null and facing == Vector2i.UP:
		canvas.draw_texture_rect_region(cape, dest, source)
	var helmet: Texture2D = GEAR.get(equipment.get("helmet", ""), null)
	if helmet != null:
		canvas.draw_texture_rect_region(helmet, dest, source)
	_draw_hands(canvas, dest, source, facing, held, shield)


## Front-held shields and weapons (weapons held behind when facing up are drawn first).
static func _draw_hands(canvas: CanvasItem, dest: Rect2, source: Rect2, facing: Vector2i, held: Texture2D,
		shield: Texture2D) -> void:
	if shield != null and facing.x == 0:
		canvas.draw_texture_rect_region(shield, dest, source)
	if held != null and facing != Vector2i.UP:
		canvas.draw_texture_rect_region(held, dest, source)


static func item_region(kind: String) -> Rect2:
	var index: int = maxi(0, ITEM_ORDER.find(kind))
	return Rect2((index % ITEM_COLUMNS) * TILE, (index / ITEM_COLUMNS) * TILE, TILE, TILE)


## Draws an item icon centred on a 32-pixel slot or ground tile. Gold coins with a `count` show a
## stack that grows with it (coins.png, COIN_STAGES).
static func draw_item(canvas: CanvasItem, center: Vector2, kind: String, tint: Color = Color.WHITE, size: float = TILE,
		count: int = 0) -> void:
	var dest := Rect2(center - Vector2.ONE * size / 2.0, Vector2.ONE * size)
	if kind == "gold_coins" and count > 0:
		canvas.draw_texture_rect_region(COINS, dest, Rect2(coin_stage(count) * TILE, 0, TILE, TILE), tint)
		return
	if ANIMATED.has(kind):
		var frame: int = int(Time.get_ticks_msec() / 1000.0 / ANIM_SECONDS) % ANIM_FRAMES
		canvas.draw_texture_rect_region(ANIMATED[kind], dest, Rect2(frame * TILE, 0, TILE, TILE), tint)
		return
	canvas.draw_texture_rect_region(ITEM_ICONS, dest, item_region(kind), tint)


## A stack count in the bottom-right corner (right-aligned at `corner`).
static func draw_count(canvas: CanvasItem, corner: Vector2, count: int) -> void:
	var font: Font = ThemeDB.fallback_font
	var text: String = str(count)
	var at: Vector2 = corner - Vector2(font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9).x, 0)
	canvas.draw_string_outline(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9, 3, OUTLINE)
	canvas.draw_string(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9, Color("#f2e6c4"))


static func draw_slot_hint(canvas: CanvasItem, center: Vector2, slot: String, size: float = TILE) -> void:
	for kind: String in ITEM_ORDER:
		if World.fits(kind, slot):
			draw_item(canvas, center, kind, Color(0, 0, 0, 0.35), size)
			return


## Draws a monster from game/data/monsters.gd; humanoids reuse the character layers and gear.
static func draw_monster(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float) -> void:
	var definition: Dictionary = Monsters.MONSTERS.get(state["kind"], {})
	if definition.is_empty():
		return
	canvas.draw_set_transform(center + FEET, 0.0, Vector2.ONE * definition["size"])
	if CREATURES.has(state["kind"]):
		var dest := Rect2(-FRAME_ANCHOR - FEET, Vector2.ONE * FRAME)
		canvas.draw_texture_rect_region(CREATURES[state["kind"]], dest, frame_region(state["facing"], stride))
	elif definition["look"] == "humanoid":
		draw_actor(canvas, -FEET, {"id": 0, "facing": state["facing"], "equipment": definition.get("gear", {}),
			"attack": state.get("attack", -1.0)}, false, stride, definition["color"])
	else:
		var source: Rect2 = frame_region(state["facing"], stride)
		var dest := Rect2(-FRAME_ANCHOR - FEET, Vector2.ONE * FRAME)
		canvas.draw_texture_rect_region(MONSTER_SHEETS[definition["look"]], dest, source, definition["color"])
		canvas.draw_texture_rect_region(MONSTER_DETAILS[definition["look"]], dest, source)
	canvas.draw_set_transform(Vector2.ZERO)


## Nameplate text size in map pixels (twice that on screen).
const NAME_SIZE: int = 7


## Tibia-style name and health bar above a creature; the bar turns yellow, then red.
static func draw_nameplate(canvas: CanvasItem, center: Vector2, text: String, health: int, max_health: int,
		height: float = 1.0, skull: String = "", name_color: Color = Color.TRANSPARENT, party: String = "",
		compact: bool = false) -> void:
	var font: Font = ThemeDB.fallback_font
	var top: float = center.y - 30.0 - 12.0 * (height - 1.0) + (4.0 * height if compact else 0.0)
	var fraction: float = clampf(float(health) / maxf(1.0, max_health), 0.0, 1.0)
	var color: Color = Color("#5ad04a") if fraction > 0.6 else (Color("#e0c040") if fraction > 0.3 else Color("#e04a3a"))
	var width: float = font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, NAME_SIZE).x
	var at := Vector2(center.x - width / 2.0, top - 4.0)
	canvas.draw_string_outline(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, NAME_SIZE, 3, OUTLINE)
	canvas.draw_string(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, NAME_SIZE, name_color if name_color.a > 0.0 else color)
	canvas.draw_rect(Rect2(center.x - 13, top - 1, 26, 4), OUTLINE)
	canvas.draw_rect(Rect2(center.x - 12, top, 24.0 * fraction, 2), color)
	if not skull.is_empty():
		draw_skull(canvas, Vector2(center.x + 18, top), skull)
	if not party.is_empty():
		draw_party_mark(canvas, Vector2(center.x - 18, top), party)


## Party shield beside the nameplate: blue for your party, gold-rimmed for its leader and
## outlined for a pending invitation.
static func draw_party_mark(canvas: CanvasItem, at: Vector2, party: String) -> void:
	var shield := PackedVector2Array([at + Vector2(-4, -4), at + Vector2(4, -4), at + Vector2(4, 1),
		at + Vector2(0, 5), at + Vector2(-4, 1)])
	var fill: Color = Color("#3a7ad0") if party != "invited" else Color(0.23, 0.48, 0.82, 0.25)
	canvas.draw_colored_polygon(shield, fill)
	shield.append(shield[0])
	canvas.draw_polyline(shield, Color("#e8c050") if party == "leader" else OUTLINE, 1.0)


## Name colour for a monster compared with your level: white is fair, yellow is tough,
## red is likely deadly.
static func danger_color(monster_level: int, player_level: int) -> Color:
	var gap: int = monster_level - player_level
	if gap >= 5:
		return Color("#ff6a50")
	if gap >= 2:
		return Color("#f0d060")
	return Color("#f2f0e6")


## A small PvP skull and crossbones: white for attacking unmarked players, red after three
## unjustified kills. The bones cross behind the jaw, each end a double knuckle.
static func draw_skull(canvas: CanvasItem, at: Vector2, skull: String) -> void:
	var bone: Color = Color("#f2f0e6") if skull == "white" else Color("#e0362a")
	var bones: Array = [[at + Vector2(-5.5, -1.5), at + Vector2(5.5, 6.5)], [at + Vector2(5.5, -1.5), at + Vector2(-5.5, 6.5)]]
	for pass_color: Color in [OUTLINE, bone]:
		var outline: bool = pass_color == OUTLINE
		for ends: Array in bones:
			canvas.draw_line(ends[0], ends[1], pass_color, 3.0 if outline else 1.5)
			for end: Vector2 in ends:
				var along: Vector2 = (end - at - Vector2(0, 2.5)).normalized()
				var across := Vector2(-along.y, along.x)
				for side: float in [-1.0, 1.0]:
					canvas.draw_circle(end + across * side * 1.1, 1.7 if outline else 1.0, pass_color)
	canvas.draw_circle(at, 4.5, OUTLINE)
	canvas.draw_rect(Rect2(at + Vector2(-3, 1), Vector2(6, 4.5)), OUTLINE)
	canvas.draw_circle(at, 3.5, bone)
	canvas.draw_rect(Rect2(at + Vector2(-2, 1), Vector2(4, 3)), bone)
	canvas.draw_rect(Rect2(at + Vector2(-2, -1), Vector2(1.5, 1.5)), OUTLINE)
	canvas.draw_rect(Rect2(at + Vector2(0.5, -1), Vector2(1.5, 1.5)), OUTLINE)


# ---------------------------------------------------------------- glow (additive pass)

## Halos of worn relics; call on an additive canvas with the same centre as draw_actor.
static func draw_actor_glow(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float, strength: float) -> bool:
	var lift: float = rider_lift(state, stride)
	var source: Rect2 = frame_region(state["facing"], 0.0 if lift > 0.0 else stride, state.get("attack", -1.0))
	var dest: Rect2 = Rect2(center - FRAME_ANCHOR - Vector2(0, lift), Vector2.ONE * FRAME)
	if lift > 0.0 and state["facing"].x == 0:
		source.size.y = RIDER_CUT
		dest.size.y = RIDER_CUT
	var glowing: bool = false
	for slot: String in VISIBLE_SLOTS:
		var kind: String = String(state["equipment"].get(slot, ""))
		if GEAR_GLOW.has(kind):
			canvas.draw_texture_rect_region(GEAR_GLOW[kind], dest, source, Color(World.ITEMS[kind]["glow"], strength))
			glowing = true
	return glowing


## Boss halos: glowing relic gear on humanoids, or the creature's own "glow" colour.
static func draw_monster_glow(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float, strength: float) -> bool:
	var definition: Dictionary = Monsters.MONSTERS.get(state["kind"], {})
	if definition.is_empty():
		return false
	var glowing: bool = false
	canvas.draw_set_transform(center + FEET, 0.0, Vector2.ONE * definition["size"])
	if definition["look"] == "humanoid":
		glowing = draw_actor_glow(canvas, -FEET, {"facing": state["facing"], "equipment": definition.get("gear", {}),
			"attack": state.get("attack", -1.0)}, stride, strength)
	elif definition.has("glow") and CREATURE_GLOW.has(state["kind"]):
		var dest := Rect2(-FRAME_ANCHOR - FEET, Vector2.ONE * FRAME)
		canvas.draw_texture_rect_region(CREATURE_GLOW[state["kind"]], dest, frame_region(state["facing"], stride),
			Color(definition["glow"], strength))
		glowing = true
	elif definition.has("glow") and MONSTER_GLOW.has(definition["look"]):
		var dest := Rect2(-FRAME_ANCHOR - FEET, Vector2.ONE * FRAME)
		canvas.draw_texture_rect_region(MONSTER_GLOW[definition["look"]], dest, frame_region(state["facing"], stride),
			Color(definition["glow"], strength))
		glowing = true
	canvas.draw_set_transform(Vector2.ZERO)
	return glowing


static func draw_item_glow(canvas: CanvasItem, center: Vector2, entry: String, strength: float) -> bool:
	var kind: String = World.kind_of(entry)
	if not World.ITEMS.has(kind) or not World.ITEMS[kind].has("glow"):
		return false
	canvas.draw_texture_rect_region(ITEM_GLOW, Rect2(center - Vector2.ONE * TILE / 2.0, Vector2.ONE * TILE),
		item_region(kind), Color(World.ITEMS[kind]["glow"], strength))
	return true
