extends RefCounted
## Draws Brimholt from the original sprite sheets in res://assets/sprites (generated by
## tools/generators/make_sprites.py and editable by hand). Character-style sheets use 64x64 frames:
## columns stand/step A/step B, rows down/up/left/right, tile centre at (32, 40), so
## unarmoured characters stand about 38 pixels tall; their feet remain at frame y=53.

const World = preload("res://game/core/world.gd")
const Dungeons = preload("res://game/data/dungeons.gd")
const Biomes = preload("res://game/data/biomes.gd")
const Caves = preload("res://game/data/caves.gd")
const Monsters = preload("res://game/data/monsters.gd")
const Balance = preload("res://game/data/balance.gd")
const Atlas = preload("res://game/data/atlas.gd")
const FRAME: float = 64.0
const FRAME_ANCHOR: Vector2 = Vector2(32, 40)
const TILE: float = 32.0
const DIRECTIONS: Array[Vector2i] = [Vector2i.DOWN, Vector2i.UP, Vector2i.LEFT, Vector2i.RIGHT]
const OUTLINE: Color = Color("#1a1612")
## Characters and monsters wear the OpenTibia pack's outfits (plan 49; otsp_export.py outfits): one sheet
## per looktype of OUTFIT_FRAME frames laid out like frame_region, placed as the pack draws them so the
## tile centre sits at OUTFIT_ANCHOR. A player outfit stacks five blocks (the untinted outfit, then its
## head, body, legs, and feet parts, tinted like Tibia's outfit colours); a creature has the first only.
const OUTFIT_FRAME: float = 72.0
const OUTFIT_ANCHOR: Vector2 = Vector2(56, 56)
const OUTFIT_PARTS: int = 5
const OUTFITS: Dictionary = {"adventurer": 17, "knight": 18, "paladin": 45, "sorcerer": 20, "druid": 21}
## Head, body, legs, and feet colours by vocation (a tint replaces the body colour). The pack's masks
## differ by outfit: the Warrior's helmet is in its "feet" part, and the robes (Sorcerer, Druid) only
## tint the hair, so those two differ by hair colour.
const OUTFIT_COLORS: Dictionary = {
	"adventurer": [Color("#c89a50"), Color("#8a7a5a"), Color("#5a4a3a"), Color("#4a3a2a")],
	"knight": [Color("#a8aeb6"), Color("#8a2a2a"), Color("#5a5a62"), Color("#c0c8d0")],
	"paladin": [Color("#c89a50"), Color("#3a6a3a"), Color("#6a4a2a"), Color("#4a3a2a")],
	"sorcerer": [Color("#e0e0e8"), Color("#3a3a8a"), Color("#2a2a5a"), Color("#4a3a2a")],
	"druid": [Color("#b0602a"), Color("#3a7a3a"), Color("#2a4a2a"), Color("#4a3a2a")],
}
## Townsfolk wear this looktype (the pack's other player outfit).
const TOWNSFOLK_OUTFIT: int = 16
static var OUTFIT_SHEETS: Dictionary = _outfit_sheets()
const MARKER: Texture2D = preload("res://assets/sprites/marker.png")
const ITEM_ICONS: Texture2D = preload("res://assets/sprites/items.png")
## Roofs from the pack's roof tiles, composed per building by roof_art.gd.
const RoofArt = preload("res://game/render/roof_art.gd")
const Buildings = preload("res://game/data/buildings.gd")
const FURNITURE: Array[String] = ["counter_shop", "counter_bank", "shelf_potions", "shelf_books", "weapon_rack", "barrel",
	"crate", "strongbox", "anvil", "workbench", "cauldron", "loom", "hearth", "bed", "table", "chair", "plant", "chest",
	"lamp_post", "well", "bench", "stall", "stall_back", "bench_back",
	"pillar", "knight_statue", "gargoyle", "bush", "flower_vase", "potted_palm", "candelabra", "fruit_table", "stove", "throne"]
const WALL_DECOR: Array[String] = ["banner", "wall_torch", "painting"]
const FOUNTAIN_KINDS: Array[String] = ["fountain", "fountain_basin"]
static var _roofs: Dictionary = {}
const SIGN_KINDS: Array[String] = ["vendor", "banker", "artisan", "warden"]
## Spells and runes landing (Combat.cast, Combat.use_rune; Spells.ELEMENTS): per element a row of
## RUNE_FX_FRAMES 32x32 frames, played once over RUNE_FX_SECONDS on every tile hit.
const RUNE_FX: Texture2D = preload("res://assets/sprites/rune_fx.png")
const RUNE_FX_ELEMENTS: Array[String] = ["fire", "frost", "lightning", "holy", "nature", "slash", "pierce", "heal", "death", "ice_wall"]
## Effects that stand for their whole `life` (Glacier wall): rise, hold on frames 1-2, crack and melt.
const HELD_FX: Array[String] = ["ice_wall"]
## Spell projectiles (make_sprites.py spell_missile): a row of MISSILE_FRAMES frames per element,
## pointing right; drawn turned toward the target.
const SPELL_MISSILES: Texture2D = preload("res://assets/sprites/spell_missiles.png")
const MISSILE_ELEMENTS: Array[String] = ["fire", "frost", "lightning", "holy", "nature", "pierce"]
const MISSILE_FRAMES: int = 4
const MISSILE_SIZE: int = 16
const RUNE_FX_FRAMES: int = 4
const RUNE_FX_SECONDS: float = 0.6
## Where a sign's centre hangs from its wall cell's corner, by the direction the door faces:
## at mid-height on the visible south or east face (a face point leans one px up-left per px of
## height), or standing on the roof edge for a north or west door.
const SIGN_OFFSETS: Dictionary = {
	Vector2i.DOWN: Vector2(4, 6), Vector2i.UP: Vector2(-16, -40), Vector2i.RIGHT: Vector2(6, 0), Vector2i.LEFT: Vector2(-28, -10),
}
const NPC_TINT: Color = Color("#4f7f86")
## Items whose icon moves (assets/sprites/items_anim/<id>.png, ANIM_FRAMES 32x32 frames in a row,
## from make_sprites.py icon_frames): flames flicker, halos and eyes glow, sheen sweeps across.
static var ANIMATED: Dictionary = _anim_sheets()
## Gold coin stacks by size: frame i of coins.png from COIN_STAGES[i] coins up (one, two, three,
## a small heap, a heap, a big heap); must match tools/generators/pixel_coins.py STAGES.
const COINS: Texture2D = preload("res://assets/sprites/coins.png")
const COIN_STAGES: Array[int] = [1, 2, 3, 4, 10, 30]
const ANIM_FRAMES: int = 12
const ANIM_SECONDS: float = 0.1
## Figures' feet sit about this far below the tile centre; monsters scale around that point.
const FEET: Vector2 = Vector2(0, 6)
## Icon order in items.png: the catalog order of game/data/items.json, ITEM_COLUMNS icons per row
## (make_sprites.py ITEM_COLUMNS; one long row would pass the 16384-pixel texture limit).
const ITEM_COLUMNS: int = 64
static var ITEM_ORDER: Array[String] = _item_order()
## Relics glow: white halo sheets (items_glow.png) drawn additively in the item's "glow" colour by
## game/render/glow_layer.gd; glowing monsters draw their creature GLOW_SCALE larger in that colour.
const GLOW_SCALE: float = 1.12
const ITEM_GLOW: Texture2D = preload("res://assets/sprites/items_glow.png")
## The elite cave under the frost isles' sea ice, floored with snow (game/data/caves.gd).
const ICE_CAVE: String = "rimewater_trench"
## The four sides: north, east, south, west.
const EDGES: Array[Vector2i] = [Vector2i.UP, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.LEFT]


static func _item_order() -> Array[String]:
	var order: Array[String] = []
	order.assign(World.ITEMS.keys())
	return order


static func _outfit_sheets() -> Dictionary:
	var sheets: Dictionary = {}
	var looktypes: Array = OUTFITS.values() + [TOWNSFOLK_OUTFIT]
	for kind: String in Monsters.MONSTERS:
		looktypes.append(Monsters.MONSTERS[kind]["outfit"])
	for looktype: int in looktypes:
		if not sheets.has(looktype):
			sheets[looktype] = load("res://assets/sprites/outfits/%d.png" % looktype)
	return sheets


## The coins.png frame for a stack of `count` coins.
static func coin_stage(count: int) -> int:
	var stage: int = 0
	for index: int in COIN_STAGES.size():
		if count >= COIN_STAGES[index]:
			stage = index
	return stage


static func _anim_sheets() -> Dictionary:
	var sheets: Dictionary = {}
	for kind: String in World.ITEMS:
		var path: String = "res://assets/sprites/items_anim/%s.png" % kind
		if ResourceLoader.exists(path):
			sheets[kind] = load(path)
	return sheets


static func tile_at(cell: Vector2i) -> String:
	return World.terrain(cell)


static func noise(cell: Vector2i, salt: int) -> int:
	return absi((cell.x * 73856093) ^ (cell.y * 19349663) ^ (salt * 83492791)) % 1000003


## The ground a stairway cell stands on: the walkable ground most common round it (floor, street,
## grass, sand...), so the way down or up is set into it and the shader blends it like its
## neighbours.
static func ground_under(cell: Vector2i) -> String:
	var counts: Dictionary = {}
	for dy: int in range(-1, 2):
		for dx: int in range(-1, 2):
			var next: String = tile_at(cell + Vector2i(dx, dy))
			if not next.is_empty() and next in World.LAND and next not in ["v", "^"]:
				counts[next] = counts.get(next, 0) + (2 if dx == 0 or dy == 0 else 1)
	var best: String = "."
	for kind: String in counts:
		if counts[kind] > counts.get(best, 0):
			best = kind
	return best




## Whether a castle wall cell belongs to a tower: some 2x2 square of castle wall holds it.
static func tower(cell: Vector2i) -> bool:
	if tile_at(cell) != "W":
		return false
	for corner: Vector2i in [Vector2i(-1, -1), Vector2i(0, -1), Vector2i(-1, 0), Vector2i(0, 0)]:
		var square: Vector2i = cell + corner
		if tile_at(square) == "W" and tile_at(square + Vector2i.RIGHT) == "W" and tile_at(square + Vector2i.DOWN) == "W" \
				and tile_at(square + Vector2i.ONE) == "W":
			return true
	return false


## Natural rock, drawn as the mountains' seamless rock blocks: mountains ("L"), the overworld's
## rock outcrops, and the rock of every cave ("C").
static func natural_rock(cell: Vector2i) -> bool:
	var tile: String = tile_at(cell)
	return tile == "L" or tile == "C"


## A cave hewn by nature, not built: an elite or farming cave, the underground's tunnels, or a
## dungeon with rock walls.
static func rock_cave(cell: Vector2i) -> bool:
	if not Caves.at(cell).is_empty() or Atlas.below_ground(cell):
		return true
	var place: Array = World.dungeon_at(cell)
	return not place.is_empty() and Dungeons.DUNGEONS[place[0]]["wall"] in ["L", "C"]


## A thin wall's connected sides: walls, and building doorways (so a door fills the gap exactly).
static func thin_wall_mask(cell: Vector2i) -> int:
	var mask: int = 0
	var bits: Array[Vector2i] = [Vector2i.UP, Vector2i.LEFT, Vector2i.DOWN, Vector2i.RIGHT]
	for bit: int in bits.size():
		var next: Vector2i = cell + bits[bit]
		var tile: String = tile_at(next)
		# Only a building's doorway joins the wall over it: a one-tile corridor between two walls
		# (dungeons, alleys) looks like a doorway too, but there the walls stay apart.
		if (not tile.is_empty() and tile in World.WALLS) or (World.ROOM_AT.has(next) or castle_stone(next) and World.OVERWORLD.has_point(next)) 				and Buildings.is_door(World.terrain, next):
			mask |= 1 << bit
	return mask


## Whether a wall or doorway belongs to a castle keep: a sandstone floor or carpet beside it.
static func castle_stone(cell: Vector2i) -> bool:
	for dy: int in range(-1, 2):
		for dx: int in range(-1, 2):
			if tile_at(cell + Vector2i(dx, dy)) in ["F", "Y"]:
				return true
	return false


## The theme of the dungeon copy a cell lies in ("" on the overworld).
static func theme_at(cell: Vector2i) -> String:
	var place: Array = World.dungeon_at(cell)
	return "" if place.is_empty() else Dungeons.theme_at(place[0])


## A building's roof (roof_art.gd), composed the first time it is drawn.
static func draw_roof(canvas: CanvasItem, index: int, building: Dictionary, alpha: float) -> void:
	if not _roofs.has(index):
		_roofs[index] = RoofArt.build(building)
	canvas.draw_texture(_roofs[index]["texture"], _roofs[index]["origin"], Color(1, 1, 1, alpha))



## A spell projectile at `at` (map pixels) flying along `direction`; false when its element has no
## sprite (melee strikes and tinted spells), so the caller draws the plain line instead.
static func draw_missile(canvas: CanvasItem, at: Vector2, direction: Vector2, element: String, age: float) -> bool:
	var row: int = MISSILE_ELEMENTS.find(element)
	if row < 0:
		return false
	var frame: int = int(age * 24.0) % MISSILE_FRAMES
	canvas.draw_set_transform(at, direction.angle(), Vector2.ONE)
	canvas.draw_texture_rect_region(SPELL_MISSILES, Rect2(-Vector2.ONE * MISSILE_SIZE / 2.0, Vector2.ONE * MISSILE_SIZE),
		Rect2(frame * MISSILE_SIZE, row * MISSILE_SIZE, MISSILE_SIZE, MISSILE_SIZE))
	canvas.draw_set_transform(Vector2.ZERO)
	return true


## One tile of a rune spell `age` seconds after it landed; false once it has played out. A held
## effect (HELD_FX) plays over its `life` instead.
static func draw_rune_fx(canvas: CanvasItem, cell: Vector2i, element: String, age: float, life: float = 0.0) -> bool:
	var row: int = RUNE_FX_ELEMENTS.find(element)
	var held: bool = element in HELD_FX and life > 0.0
	if row < 0 or age >= (life if held else RUNE_FX_SECONDS):
		return false
	var frame: int = mini(RUNE_FX_FRAMES - 1, floori(age / RUNE_FX_SECONDS * RUNE_FX_FRAMES))
	if held:
		frame = 0 if age < 0.15 else 3 if age > life - 0.4 else 1 + int(age / 0.5) % 2
	canvas.draw_texture_rect_region(RUNE_FX, Rect2(Vector2(cell) * TILE - Vector2(0, 6), Vector2.ONE * TILE),
		Rect2(frame * TILE, row * TILE, TILE, TILE))
	return true


## Character sheets have five columns per facing: stand, step A, step B, attack wind-up, and
## strike. A view whose "attack_born" is recent plays the attack, turned toward its target.
const ATTACK_SECONDS: float = 0.4
const WIND_UP_SECONDS: float = 0.14
const GATHER_SWING: float = 0.75


## The state to draw for a creature view at `time`: during an attack, a copy facing the
## target with "attack" set to the attack's age; otherwise the state itself.
static func posed(view: Dictionary, time: float) -> Dictionary:
	var age: float = time - float(view.get("attack_born", -100.0))
	if (age < 0.0 or age >= ATTACK_SECONDS) and view["state"].has("gathering"):
		# Gathering swings a tool (or the line) at the node every GATHER_SWING seconds.
		var swing: Dictionary = view["state"].duplicate()
		swing["attack"] = fmod(time, GATHER_SWING)
		return swing
	if age < 0.0 or age >= ATTACK_SECONDS:
		return view["state"]
	var state: Dictionary = view["state"].duplicate()
	state["facing"] = view.get("attack_facing", state["facing"])
	state["attack"] = age
	return state


static func frame_region(facing: Vector2i, stride: float, attack: float = -1.0) -> Rect2:
	var column: int = 0
	if attack >= 0.0 and attack < ATTACK_SECONDS:
		column = 3 if attack < WIND_UP_SECONDS else 4
	elif stride > 0.0:
		column = 1 if stride < 0.5 else 2
	return Rect2(column * FRAME, maxi(0, DIRECTIONS.find(facing)) * FRAME, FRAME, FRAME)


## stride is the 0..1 progress of the current step, or 0 when standing still. The look is the
## vocation's outfit (state "vocation"), or state "outfit" (a looktype) for townsfolk and monsters;
## a tint colours its body. Worn gear is not drawn (plan 49).
static func draw_actor(canvas: CanvasItem, center: Vector2, state: Dictionary, local: bool, stride: float = 0.0,
		tint: Color = Color.TRANSPARENT) -> void:
	var source: Rect2 = frame_region(state["facing"], stride, state.get("attack", -1.0))
	if local:
		canvas.draw_texture_rect_region(MARKER, Rect2(center - FRAME_ANCHOR, Vector2.ONE * FRAME), source)
	var vocation: String = String(state.get("vocation", ""))
	var colors: Array = OUTFIT_COLORS.get(vocation, OUTFIT_COLORS[Balance.ADVENTURER])
	var sheet: Texture2D = OUTFIT_SHEETS[int(state.get("outfit", OUTFITS.get(vocation, OUTFITS[Balance.ADVENTURER])))]
	var dest := Rect2(center - OUTFIT_ANCHOR, Vector2.ONE * OUTFIT_FRAME)
	var frame := Rect2(source.position / FRAME * OUTFIT_FRAME, Vector2.ONE * OUTFIT_FRAME)
	for part: int in mini(OUTFIT_PARTS, roundi(sheet.get_height() / (4 * OUTFIT_FRAME))):
		var color: Color = Color.WHITE if part == 0 else colors[part - 1]
		if part == 2 and tint.a > 0.0:
			color = tint
		canvas.draw_texture_rect_region(sheet, dest, Rect2(frame.position + Vector2(0, part * 4 * OUTFIT_FRAME), frame.size), color)


static func item_region(kind: String) -> Rect2:
	var index: int = maxi(0, ITEM_ORDER.find(kind))
	return Rect2((index % ITEM_COLUMNS) * TILE, (index / ITEM_COLUMNS) * TILE, TILE, TILE)


## Draws an item icon centred on a 32-pixel slot or ground tile. Gold coins with a `count` show a
## stack that grows with it (coins.png, COIN_STAGES).
static func draw_item(canvas: CanvasItem, center: Vector2, kind: String, tint: Color = Color.WHITE, size: float = TILE,
		count: int = 0) -> void:
	var dest := Rect2(center - Vector2.ONE * size / 2.0, Vector2.ONE * size)
	if kind == "gold_coins" and count > 0:
		canvas.draw_texture_rect_region(COINS, dest, Rect2(coin_stage(count) * TILE, 0, TILE, TILE), tint)
		return
	if ANIMATED.has(kind):
		var frame: int = int(Time.get_ticks_msec() / 1000.0 / ANIM_SECONDS) % ANIM_FRAMES
		canvas.draw_texture_rect_region(ANIMATED[kind], dest, Rect2(frame * TILE, 0, TILE, TILE), tint)
		return
	canvas.draw_texture_rect_region(ITEM_ICONS, dest, item_region(kind), tint)


## A stack count in the bottom-right corner (right-aligned at `corner`).
static func draw_count(canvas: CanvasItem, corner: Vector2, count: int) -> void:
	var font: Font = ThemeDB.fallback_font
	var text: String = str(count)
	var at: Vector2 = corner - Vector2(font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9).x, 0)
	canvas.draw_string_outline(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9, 3, OUTLINE)
	canvas.draw_string(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, 9, Color("#f2e6c4"))


static func draw_slot_hint(canvas: CanvasItem, center: Vector2, slot: String, size: float = TILE) -> void:
	for kind: String in ITEM_ORDER:
		if World.fits(kind, slot):
			draw_item(canvas, center, kind, Color(0, 0, 0, 0.35), size)
			return


## Draws a monster from game/data/monsters.gd: its pack creature at its size.
static func draw_monster(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float) -> void:
	var definition: Dictionary = Monsters.MONSTERS.get(state["kind"], {})
	if definition.is_empty():
		return
	canvas.draw_set_transform(center + FEET, 0.0, Vector2.ONE * definition["size"])
	draw_actor(canvas, -FEET, {"facing": state["facing"], "outfit": definition["outfit"], "attack": state.get("attack", -1.0)},
		false, stride)
	canvas.draw_set_transform(Vector2.ZERO)


## Nameplate text size in map pixels (twice that on screen).
const NAME_SIZE: int = 7


## Tibia-style name and health bar above a creature; the bar turns yellow, then red.
static func draw_nameplate(canvas: CanvasItem, center: Vector2, text: String, health: int, max_health: int,
		height: float = 1.0, skull: String = "", name_color: Color = Color.TRANSPARENT, party: String = "",
		compact: bool = false) -> void:
	var font: Font = ThemeDB.fallback_font
	var top: float = center.y - 30.0 - 12.0 * (height - 1.0) + (4.0 * height if compact else 0.0)
	var fraction: float = clampf(float(health) / maxf(1.0, max_health), 0.0, 1.0)
	var color: Color = Color("#5ad04a") if fraction > 0.6 else (Color("#e0c040") if fraction > 0.3 else Color("#e04a3a"))
	var width: float = font.get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, NAME_SIZE).x
	var at := Vector2(center.x - width / 2.0, top - 4.0)
	canvas.draw_string_outline(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, NAME_SIZE, 3, OUTLINE)
	canvas.draw_string(font, at, text, HORIZONTAL_ALIGNMENT_LEFT, -1, NAME_SIZE, name_color if name_color.a > 0.0 else color)
	canvas.draw_rect(Rect2(center.x - 13, top - 1, 26, 4), OUTLINE)
	canvas.draw_rect(Rect2(center.x - 12, top, 24.0 * fraction, 2), color)
	if not skull.is_empty():
		draw_skull(canvas, Vector2(center.x + 18, top), skull)
	if not party.is_empty():
		draw_party_mark(canvas, Vector2(center.x - 18, top), party)


## Party shield beside the nameplate: blue for your party, gold-rimmed for its leader and
## outlined for a pending invitation.
static func draw_party_mark(canvas: CanvasItem, at: Vector2, party: String) -> void:
	var shield := PackedVector2Array([at + Vector2(-4, -4), at + Vector2(4, -4), at + Vector2(4, 1),
		at + Vector2(0, 5), at + Vector2(-4, 1)])
	var fill: Color = Color("#3a7ad0") if party != "invited" else Color(0.23, 0.48, 0.82, 0.25)
	canvas.draw_colored_polygon(shield, fill)
	shield.append(shield[0])
	canvas.draw_polyline(shield, Color("#e8c050") if party == "leader" else OUTLINE, 1.0)


## Name colour for a monster compared with your level: white is fair, yellow is tough,
## red is likely deadly.
static func danger_color(monster_level: int, player_level: int) -> Color:
	var gap: int = monster_level - player_level
	if gap >= 5:
		return Color("#ff6a50")
	if gap >= 2:
		return Color("#f0d060")
	return Color("#f2f0e6")


## A small PvP skull and crossbones: white for attacking unmarked players, red after three
## unjustified kills. The bones cross behind the jaw, each end a double knuckle.
static func draw_skull(canvas: CanvasItem, at: Vector2, skull: String) -> void:
	var bone: Color = Color("#f2f0e6") if skull == "white" else Color("#e0362a")
	var bones: Array = [[at + Vector2(-5.5, -1.5), at + Vector2(5.5, 6.5)], [at + Vector2(5.5, -1.5), at + Vector2(-5.5, 6.5)]]
	for pass_color: Color in [OUTLINE, bone]:
		var outline: bool = pass_color == OUTLINE
		for ends: Array in bones:
			canvas.draw_line(ends[0], ends[1], pass_color, 3.0 if outline else 1.5)
			for end: Vector2 in ends:
				var along: Vector2 = (end - at - Vector2(0, 2.5)).normalized()
				var across := Vector2(-along.y, along.x)
				for side: float in [-1.0, 1.0]:
					canvas.draw_circle(end + across * side * 1.1, 1.7 if outline else 1.0, pass_color)
	canvas.draw_circle(at, 4.5, OUTLINE)
	canvas.draw_rect(Rect2(at + Vector2(-3, 1), Vector2(6, 4.5)), OUTLINE)
	canvas.draw_circle(at, 3.5, bone)
	canvas.draw_rect(Rect2(at + Vector2(-2, 1), Vector2(4, 3)), bone)
	canvas.draw_rect(Rect2(at + Vector2(-2, -1), Vector2(1.5, 1.5)), OUTLINE)
	canvas.draw_rect(Rect2(at + Vector2(0.5, -1), Vector2(1.5, 1.5)), OUTLINE)


# ---------------------------------------------------------------- glow (additive pass)

## Glowing monsters: their creature again in their "glow" colour, a little larger, as a halo.
static func draw_monster_glow(canvas: CanvasItem, center: Vector2, state: Dictionary, stride: float, strength: float) -> bool:
	var definition: Dictionary = Monsters.MONSTERS.get(state["kind"], {})
	if not definition.has("glow"):
		return false
	var sheet: Texture2D = OUTFIT_SHEETS[definition["outfit"]]
	var source: Rect2 = frame_region(state["facing"], stride, state.get("attack", -1.0))
	var frame := Rect2(source.position / FRAME * OUTFIT_FRAME, Vector2.ONE * OUTFIT_FRAME)
	canvas.draw_set_transform(center + FEET, 0.0, Vector2.ONE * definition["size"] * GLOW_SCALE)
	canvas.draw_texture_rect_region(sheet, Rect2(-FEET - OUTFIT_ANCHOR, Vector2.ONE * OUTFIT_FRAME), frame,
		Color(definition["glow"], strength))
	canvas.draw_set_transform(Vector2.ZERO)
	return true


static func draw_item_glow(canvas: CanvasItem, center: Vector2, entry: String, strength: float) -> bool:
	var kind: String = World.kind_of(entry)
	if not World.ITEMS.has(kind) or not World.ITEMS[kind].has("glow"):
		return false
	canvas.draw_texture_rect_region(ITEM_GLOW, Rect2(center - Vector2.ONE * TILE / 2.0, Vector2.ONE * TILE),
		item_region(kind), Color(World.ITEMS[kind]["glow"], strength))
	return true
